{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codecity-inspector.local/asset-forge/sprite-sheet.schema.json",
  "title": "SpriteSheetSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assetId", "sourcePath", "frameWidth", "frameHeight", "columns", "rows", "frames"
  ],
  "properties": {
    "visualContractVersion": { "enum": [1, 2] },
    "layout": { "enum": ["legacy", "character-4x10", "terrain-blob16"] },
    "assetId": { "type": "string", "minLength": 1 },
    "sourcePath": { "type": "string", "minLength": 1 },
    "frameWidth": { "type": "integer", "minimum": 1 },
    "frameHeight": { "type": "integer", "minimum": 1 },
    "columns": { "type": "integer", "minimum": 1 },
    "rows": { "type": "integer", "minimum": 1 },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "x", "y", "width", "height"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "x": { "type": "integer", "minimum": 0 },
          "y": { "type": "integer", "minimum": 0 },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "direction": { "enum": ["front", "back", "left", "right"] },
          "animation": { "type": "string", "minLength": 1 },
          "index": { "type": "integer", "minimum": 0 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "visualContractVersion": { "const": 2 } },
        "required": ["visualContractVersion"]
      },
      "then": {
        "required": ["layout"],
        "properties": { "layout": { "enum": ["character-4x10", "terrain-blob16"] } }
      }
    },
    {
      "if": {
        "properties": {
          "visualContractVersion": { "const": 2 },
          "layout": { "const": "character-4x10" }
        },
        "required": ["visualContractVersion", "layout"]
      },
      "then": {
        "properties": {
          "frameWidth": { "const": 48 },
          "frameHeight": { "const": 96 },
          "columns": { "const": 10 },
          "rows": { "const": 4 },
          "frames": { "type": "array", "minItems": 40, "maxItems": 40 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "visualContractVersion": { "const": 2 },
          "layout": { "const": "terrain-blob16" }
        },
        "required": ["visualContractVersion", "layout"]
      },
      "then": {
        "properties": {
          "frameWidth": { "const": 64 },
          "frameHeight": { "const": 64 },
          "columns": { "const": 5 },
          "rows": { "const": 5 },
          "frames": { "type": "array", "minItems": 25, "maxItems": 25 }
        }
      }
    }
  ]
}
