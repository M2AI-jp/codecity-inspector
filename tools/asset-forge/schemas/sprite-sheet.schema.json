{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codecity-inspector.local/asset-forge/sprite-sheet.schema.json",
  "title": "SpriteSheetSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assetId", "sourcePath", "frameWidth", "frameHeight", "columns", "rows", "frames"
  ],
  "properties": {
    "assetId": { "type": "string", "minLength": 1 },
    "sourcePath": { "type": "string", "minLength": 1 },
    "frameWidth": { "type": "integer", "minimum": 1 },
    "frameHeight": { "type": "integer", "minimum": 1 },
    "columns": { "type": "integer", "minimum": 1 },
    "rows": { "type": "integer", "minimum": 1 },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "x", "y", "width", "height"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "x": { "type": "integer", "minimum": 0 },
          "y": { "type": "integer", "minimum": 0 },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "direction": { "enum": ["front", "back", "left", "right"] },
          "animation": { "type": "string", "minLength": 1 },
          "index": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
