{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codecity-inspector.local/asset-forge/reference-rights-review-v2.schema.json",
  "title": "Fable5WaveReferenceRightsReview",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "reviewType", "requiredSetId", "waveId", "status", "reviewer",
    "reviewedAt", "ownerAuthorizationSha256", "assetReferenceMapSha256",
    "authorizedReferenceIds", "forbiddenReferenceIds", "observed", "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "reviewType": { "const": "fable5-wave-reference-rights" },
    "requiredSetId": { "const": "fable5-v2" },
    "waveId": { "const": "A" },
    "status": { "enum": ["pass", "fail"] },
    "reviewer": { "const": "independent-read-only" },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "ownerAuthorizationSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "assetReferenceMapSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "authorizedReferenceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)*$" }
    },
    "forbiddenReferenceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)*$" }
    },
    "observed": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
