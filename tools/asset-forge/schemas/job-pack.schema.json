{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codecity-inspector.local/asset-forge/job-pack.schema.json",
  "title": "JobPack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "jobId", "assetId", "promptPath", "referenceIds",
    "outputContractPath", "importCommandPath", "status"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "jobId": { "type": "string", "minLength": 1 },
    "assetId": { "type": "string", "minLength": 1 },
    "promptPath": { "type": "string", "pattern": "^generated/jobs/" },
    "referenceIds": { "type": "array", "items": { "type": "string" } },
    "outputContractPath": { "type": "string", "pattern": "^generated/jobs/" },
    "importCommandPath": { "type": "string", "pattern": "^generated/jobs/" },
    "status": { "const": "job-pack" }
  }
}
