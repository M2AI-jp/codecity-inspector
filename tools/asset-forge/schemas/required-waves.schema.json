{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codecity-inspector.local/asset-forge/required-waves.schema.json",
  "title": "RequiredAssetWaves",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requiredSetId", "waves"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requiredSetId": { "const": "fable5-v2" },
    "waves": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "requiredAssetCount", "minimumOutputPngCount", "assetIdsSha256", "assetIds"],
        "properties": {
          "id": { "enum": ["A", "B"] },
          "requiredAssetCount": { "type": "integer", "minimum": 1 },
          "minimumOutputPngCount": { "type": "integer", "minimum": 1 },
          "assetIdsSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "assetIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(character|building|terrain|overlay|structure|interior|prop|ui|effect)\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*$"
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "id": { "const": "A" } }, "required": ["id"] },
            "then": {
              "properties": {
                "requiredAssetCount": { "const": 109 },
                "minimumOutputPngCount": { "const": 128 },
                "assetIdsSha256": { "const": "355b452e48940cd9b861de207b32be507f974133f1913cf70bc01861d113c1bd" },
                "assetIds": { "type": "array", "minItems": 109, "maxItems": 109 }
              }
            }
          },
          {
            "if": { "properties": { "id": { "const": "B" } }, "required": ["id"] },
            "then": {
              "properties": {
                "requiredAssetCount": { "const": 49 },
                "minimumOutputPngCount": { "const": 49 },
                "assetIdsSha256": { "const": "98c2480099ff0ca2336084a89c51c8e2e587d06d79d78938c40343462e17289b" },
                "assetIds": { "type": "array", "minItems": 49, "maxItems": 49 }
              }
            }
          }
        ]
      }
    }
  }
}
