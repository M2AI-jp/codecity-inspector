            { "const": "left" }, { "const": "right" }
          ],
          "additionalItems": false
        },
        "frameColumns": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": [
            { "const": "idle_1" }, { "const": "idle_2" },
            { "const": "walk_1" }, { "const": "walk_2" },
            { "const": "walk_3" }, { "const": "walk_4" },
            { "const": "talk_1" }, { "const": "talk_2" },
            { "const": "work_1" }, { "const": "work_2" }
          ],
          "additionalItems": false
        },
        "animations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["idle", "walk", "talk", "work"],
          "properties": {
            "idle": { "const": [0, 1] },
            "walk": { "const": [2, 3, 4, 5] },
            "talk": { "const": [6, 7] },
            "work": { "const": [8, 9] }
          }
        },
        "footBaseline": { "const": "common" },
        "resampling": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kernel", "downscaleOnly", "allowEnlargement"],
          "properties": {
            "kernel": { "const": "nearest" },
            "downscaleOnly": { "const": true },
            "allowEnlargement": { "const": false }
          }
        },
        "visibleBboxHeight": {
          "type": "object",
          "additionalProperties": false,
          "required": ["class", "min", "max"],
          "properties": {
            "class": { "enum": ["adult", "elder", "child"] },
            "min": { "type": "integer", "minimum": 1, "maximum": 96 },
            "max": { "type": "integer", "minimum": 1, "maximum": 80 }
          }
        },
        "partialAlphaPixels": { "const": 0 }
      }
    },
    "gameBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rendererCategory", "semanticKind", "drawLayer", "runtimeBindings", "coverage"
      ],
      "properties": {
        "rendererCategory": {
          "enum": [
            "tile", "building_exterior", "building_interior", "player", "npc", "mob",
            "creature", "prop", "vehicle", "effect", "ui"
          ]
        },
        "semanticKind": { "type": "string", "minLength": 1 },
        "drawLayer": {
          "enum": ["ground", "object", "building", "character", "roof", "effect", "ui"]
        },
        "runtimeBindings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["vocabulary", "id"],
            "properties": {
              "vocabulary": {
                "enum": [
                  "TILE_TYPES", "NPC_ROLES", "PROP_KINDS",
                  "FACILITY_KINDS", "BUILDING_STATES", "WORLDPLAN_ASSET_IDS"
                ]
              },
              "id": { "type": "string", "minLength": 1 }
            }
          }
        },
        "coverage": { "enum": ["exact", "mapped", "future"] }
      }
    }
  }
}
