{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codecity-inspector.local/asset-forge/wave-a-selection-v3.schema.json",
  "title": "Fable5WaveASelectionV3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "requiredSetId", "waveId", "requiredAssetCount", "outputPngCount",
    "declaredLogicalSlotCount", "semanticCellCount", "expectedNonemptySemanticCellCount",
    "expectedTransparentSemanticCellCount", "reservedTransparentCellCount",
    "legacyDispositionDigest", "sceneBlueprints", "assets", "selectionDigest"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "requiredSetId": { "const": "fable5-v2" },
    "waveId": { "const": "A" },
    "requiredAssetCount": { "const": 109 },
    "outputPngCount": { "const": 128 },
    "declaredLogicalSlotCount": { "const": 771 },
    "semanticCellCount": { "const": 708 },
    "expectedNonemptySemanticCellCount": { "const": 696 },
    "expectedTransparentSemanticCellCount": { "const": 12 },
    "reservedTransparentCellCount": { "const": 63 },
    "legacyDispositionDigest": { "$ref": "#/definitions/sha256" },
    "sceneBlueprints": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": { "$ref": "#/definitions/blueprint" }
    },
    "assets": {
      "type": "array", "minItems": 109, "maxItems": 109,
      "items": { "$ref": "#/definitions/asset" }
    },
    "selectionDigest": { "$ref": "#/definitions/sha256" }
  },
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "assetId": {
      "type": "string",
      "pattern": "^(character|building|terrain|overlay|structure|interior|prop|ui|effect)\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*$"
    },
    "generationId": { "type": "string", "pattern": "^gen_[a-z0-9][a-z0-9_-]{0,127}$" },
    "artifactHashes": {
      "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true,
      "items": { "$ref": "#/definitions/sha256" }
    },
    "evidencePath": {
      "type": "string",
      "pattern": "^review/wave-a/evidence/[a-z0-9][a-z0-9_.-]*\\.png$"
    },
    "reviewedImage": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "path", "sha256", "artifactSha256s"],
      "properties": {
        "status": { "const": "pass" },
        "path": { "$ref": "#/definitions/evidencePath" },
        "sha256": { "$ref": "#/definitions/sha256" },
        "artifactSha256s": { "$ref": "#/definitions/artifactHashes" }
      }
    },
    "blueprintAsset": {
      "type": "object", "additionalProperties": false,
      "required": ["assetId", "artifactSha256s"],
      "properties": {
        "assetId": { "$ref": "#/definitions/assetId" },
        "artifactSha256s": { "$ref": "#/definitions/artifactHashes" }
      }
    },
    "blueprint": {
      "type": "object", "additionalProperties": false,
      "required": [
        "id", "status", "reviewer", "reviewedAt", "path", "sha256", "includedAssets"
      ],
      "properties": {
        "id": { "enum": ["old-town", "snow", "harbor", "woodland", "night", "cutaway"] },
        "status": { "const": "pass" },
        "reviewer": { "const": "human" },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "path": { "$ref": "#/definitions/evidencePath" },
        "sha256": { "$ref": "#/definitions/sha256" },
        "includedAssets": {
          "type": "array", "minItems": 1, "maxItems": 109,
          "items": { "$ref": "#/definitions/blueprintAsset" }
        }
      }
    },
    "repeatPass": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "layout", "path", "sha256", "artifactSha256s"],
      "properties": {
        "status": { "const": "pass" },
        "layout": { "const": "3x3" },
        "path": { "$ref": "#/definitions/evidencePath" },
        "sha256": { "$ref": "#/definitions/sha256" },
        "artifactSha256s": { "$ref": "#/definitions/artifactHashes" }
      }
    },
    "repeatNA": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reason", "artifactSha256s"],
      "properties": {
        "status": { "const": "not-applicable" },
        "reason": { "const": "definition-is-not-repeatable" },
        "artifactSha256s": { "$ref": "#/definitions/artifactHashes" }
      }
    },
    "ensembleEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "blueprintId", "path", "sha256", "artifactSha256s"],
      "properties": {
        "status": { "const": "pass" },
        "blueprintId": { "enum": ["old-town", "snow", "harbor", "woodland", "night", "cutaway"] },
        "path": { "$ref": "#/definitions/evidencePath" },
        "sha256": { "$ref": "#/definitions/sha256" },
        "artifactSha256s": { "$ref": "#/definitions/artifactHashes" }
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "pendingPath", "sha256"],
      "properties": {
        "role": { "enum": ["primary", "base", "roof"] },
        "pendingPath": {
          "type": "string",
          "pattern": "^generated/(characters|buildings|terrains|overlays|structures|interiors|props|ui|effects)/pending/[a-z0-9][a-z0-9_.-]*\\.png$"
        },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "visualReview": {
      "type": "object", "additionalProperties": false,
      "required": ["reviewer", "reviewedAt", "native", "repeat", "ensemble"],
      "properties": {
        "reviewer": { "const": "human" },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "native": { "$ref": "#/definitions/reviewedImage" },
        "repeat": { "oneOf": [
          { "$ref": "#/definitions/repeatPass" },
          { "$ref": "#/definitions/repeatNA" }
        ] },
        "ensemble": {
          "type": "array", "minItems": 1, "maxItems": 6,
          "items": { "$ref": "#/definitions/ensembleEvidence" }
        }
      }
    },
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": [
        "assetId", "generationId", "definitionSha256",
        "pendingGenerationRecordDigest", "artifacts", "visualReview"
      ],
      "properties": {
        "assetId": { "$ref": "#/definitions/assetId" },
        "generationId": { "$ref": "#/definitions/generationId" },
        "definitionSha256": { "$ref": "#/definitions/sha256" },
        "pendingGenerationRecordDigest": { "$ref": "#/definitions/sha256" },
        "artifacts": {
          "type": "array", "minItems": 1, "maxItems": 2,
          "items": { "$ref": "#/definitions/artifact" }
        },
        "visualReview": { "$ref": "#/definitions/visualReview" }
      }
    }
  }
}
