{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codecity-inspector.local/asset-forge/generation-job-v2.schema.json",
  "title": "Fable5WaveAGenerationJob",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "requiredSetId", "waveId", "visualContractVersion",
    "id", "assetId", "category", "provider", "seed", "assetDefinition",
    "assetDefinitionSha256", "definitionSha256", "promptText", "promptSha256",
    "promptFiles", "referenceAuthorizationSha256", "independentReviewSha256",
    "referenceImages", "artifactContracts", "generationMode", "generationUnits",
    "generationUnitSetSha256", "generationExpectations", "identityMasterPlan", "technicalGates",
    "provenanceKey", "createdBy"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "requiredSetId": { "const": "fable5-v2" },
    "waveId": { "const": "A" },
    "visualContractVersion": { "const": 2 },
    "id": { "type": "string", "pattern": "^job_v2_[a-f0-9]{20}$" },
    "assetId": {
      "type": "string",
      "pattern": "^(character|building|terrain|overlay|structure|interior|prop|ui|effect)\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*$"
    },
    "category": {
      "enum": ["character", "building", "terrain", "overlay", "structure", "interior", "prop", "ui", "effect"]
    },
    "provider": { "const": "job-pack" },
    "seed": { "type": "string" },
    "assetDefinition": { "$ref": "asset-definition.schema.json" },
    "assetDefinitionSha256": { "$ref": "#/definitions/sha256" },
    "definitionSha256": { "$ref": "#/definitions/sha256" },
    "promptText": { "type": "string", "minLength": 1 },
    "promptSha256": { "$ref": "#/definitions/sha256" },
    "promptFiles": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^prompts/v2/[a-z0-9_/-]+\\.md$" }
    },
    "referenceAuthorizationSha256": { "$ref": "#/definitions/sha256" },
    "independentReviewSha256": { "$ref": "#/definitions/sha256" },
    "referenceImages": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": [
        { "$ref": "#/definitions/globalReference" },
        { "$ref": "#/definitions/subjectReference" }
      ],
      "additionalItems": false
    },
    "artifactContracts": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": [
            {
              "allOf": [
                { "$ref": "#/definitions/artifactContract" },
                { "type": "object", "properties": { "role": { "const": "primary" } } }
              ]
            }
          ],
          "additionalItems": false
        },
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": [
            {
              "allOf": [
                { "$ref": "#/definitions/artifactContract" },
                { "type": "object", "properties": { "role": { "const": "base" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/definitions/artifactContract" },
                { "type": "object", "properties": { "role": { "const": "roof" } } }
              ]
            }
          ],
          "additionalItems": false
        }
      ]
    },
    "generationMode": { "enum": ["per-unit", "monolithic-atlas", "character-direction-strips", "terrain-composed-atlas"] },
    "terrainCompositionPlan": { "$ref": "#/definitions/terrainCompositionPlan" },
    "providerKeyNormalizationPlan": { "$ref": "#/definitions/providerKeyNormalizationPlan" },
    "characterAtlasLayoutPlan": { "$ref": "#/definitions/characterAtlasLayoutPlan" },
    "characterDirectionStripPlan": { "$ref": "#/definitions/characterDirectionStripPlan" },
    "generationUnits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "generation-unit-v2.schema.json" }
    },
    "generationUnitSetSha256": { "$ref": "#/definitions/sha256" },
    "generationExpectations": { "$ref": "#/definitions/expectations" },
    "identityMasterPlan": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "identity-master-plan-v2.schema.json" }
      ]
    },
    "technicalGates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inspectionGates", "inputPolicy"],
      "properties": {
        "inspectionGates": { "type": "object" },
        "inputPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format", "nativeOutputSize", "resizeKernel", "allowEnlargement", "allowImportMutation",
            "expectedGenerator",
            "chromaKeyColor", "chromaKeyTolerance", "hardAlphaThreshold",
            "hiddenRgbPolicy", "transparentUnitPolicy", "assemblyKernel"
          ],
          "properties": {
            "format": { "enum": ["png", "png-jpeg-webp"] },
            "nativeOutputSize": { "type": "boolean" },
            "resizeKernel": { "const": "nearest" },
            "allowEnlargement": { "const": false },
            "allowImportMutation": { "const": false },
            "expectedGenerator": { "const": "codex-imagegen-built-in" },
            "chromaKeyColor": { "oneOf": [{ "const": "#FF00FF" }, { "type": "null" }] },
            "chromaKeyTolerance": { "oneOf": [{ "const": 0 }, { "type": "null" }] },
            "canonicalBackgroundRemoval": {
              "$ref": "#/definitions/canonicalBackgroundRemovalPolicy"
            },
            "sourceLimits": { "$ref": "#/definitions/sourceLimits" },
            "hardAlphaThreshold": { "oneOf": [{ "const": 127 }, { "type": "null" }] },
            "hiddenRgbPolicy": { "enum": ["zero", "not-applicable-fully-opaque-input"] },
            "transparentUnitPolicy": { "const": "zero-rgba" },
            "assemblyKernel": {
              "enum": ["raw-copy", "terrain-composed-atlas/shared-seam-blob16-v1"]
            },
            "terrainMaterialInputs": { "$ref": "#/definitions/terrainMaterialInputs" },
            "providerKeyNormalization": { "$ref": "#/definitions/providerKeyNormalizationPlan" }
          }
        }
      }
    },
    "provenanceKey": { "$ref": "#/definitions/sha256" },
    "createdBy": { "const": "codex" }
  },
  "allOf": [
    {
      "if": { "properties": { "category": { "const": "building" } }, "required": ["category"] },
      "then": {
        "properties": {
          "artifactContracts": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": [
              { "type": "object", "properties": { "role": { "const": "base" } }, "required": ["role"] },
              { "type": "object", "properties": { "role": { "const": "roof" } }, "required": ["role"] }
            ],
            "additionalItems": false
          }
        }
      },
      "else": {
        "properties": {
          "artifactContracts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": [
              { "type": "object", "properties": { "role": { "const": "primary" } }, "required": ["role"] }
            ],
            "additionalItems": false
          }
        }
      }
    },
    {
      "if": { "properties": { "category": { "const": "character" } }, "required": ["category"] },
      "then": {
        "properties": {
          "identityMasterPlan": { "$ref": "identity-master-plan-v2.schema.json" },
          "generationUnits": {
            "type": "array", "minItems": 40, "maxItems": 40,
            "items": {
              "allOf": [
                { "$ref": "generation-unit-v2.schema.json" },
                {
                  "type": "object",
                  "properties": { "direction": {}, "consistencyPlanId": {} },
                  "required": ["direction", "consistencyPlanId"]
                }
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "identityMasterPlan": { "type": "null" },
          "generationUnits": {
            "type": "array", "minItems": 1, "maxItems": 100,
            "items": {
              "allOf": [
                { "$ref": "generation-unit-v2.schema.json" },
                {
                  "not": {
                    "type": "object",
                    "properties": { "consistencyPlanId": {} },
                    "required": ["consistencyPlanId"]
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "generationMode": { "const": "terrain-composed-atlas" } },
        "required": ["generationMode"]
      },
      "then": {
        "properties": {
          "category": { "const": "terrain" },
          "terrainCompositionPlan": { "$ref": "#/definitions/terrainCompositionPlan" },
          "technicalGates": {
            "type": "object",
            "properties": {
              "inputPolicy": { "$ref": "#/definitions/terrainInputPolicyOverlay" }
            }
          }
        },
        "required": ["terrainCompositionPlan"]
      },
      "else": {
        "allOf": [
          {
            "not": {
              "properties": { "terrainCompositionPlan": {} },
              "required": ["terrainCompositionPlan"]
            }
          },
          {
            "properties": {
              "technicalGates": {
                "type": "object",
                "properties": {
                  "inputPolicy": { "$ref": "#/definitions/legacyInputPolicyOverlay" }
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": { "providerKeyNormalizationPlan": {} },
        "required": ["providerKeyNormalizationPlan"]
      },
      "then": {
        "properties": {
          "category": { "const": "character" },
          "generationMode": { "const": "monolithic-atlas" },
          "identityMasterPlan": {
            "type": "object",
            "properties": {
              "providerKeyNormalizationPlan": { "$ref": "#/definitions/providerKeyNormalizationPlan" }
            },
            "required": ["providerKeyNormalizationPlan"]
          },
          "technicalGates": {
            "type": "object",
            "properties": {
              "inputPolicy": {
                "type": "object",
                "properties": {
                  "providerKeyNormalization": { "$ref": "#/definitions/providerKeyNormalizationPlan" }
                },
                "required": ["providerKeyNormalization"]
              }
            }
          }
        }
      },
      "else": {
        "allOf": [
          {
            "properties": {
              "identityMasterPlan": {
                "not": {
                  "type": "object",
                  "properties": { "providerKeyNormalizationPlan": {} },
                  "required": ["providerKeyNormalizationPlan"]
                }
              }
            }
          },
          {
            "properties": {
              "technicalGates": {
                "type": "object",
                "properties": {
                  "inputPolicy": {
                    "not": {
                      "type": "object",
                      "properties": { "providerKeyNormalization": {} },
                      "required": ["providerKeyNormalization"]
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": { "characterAtlasLayoutPlan": {} },
        "required": ["characterAtlasLayoutPlan"]
      },
      "then": {
        "properties": {
          "category": { "const": "character" },
          "generationMode": { "const": "monolithic-atlas" }
        }
      }
    },
    {
      "if": {
        "properties": { "generationMode": { "const": "character-direction-strips" } },
        "required": ["generationMode"]
      },
      "then": {
        "properties": {
          "category": { "const": "character" },
          "characterDirectionStripPlan": { "$ref": "#/definitions/characterDirectionStripPlan" }
        },
        "required": ["characterDirectionStripPlan"]
      },
      "else": {
        "not": {
          "properties": { "characterDirectionStripPlan": {} },
          "required": ["characterDirectionStripPlan"]
        }
      }
    }
  ],
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "characterAtlasLayoutPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "originKind", "version", "algorithm", "configSha256",
        "overallContentGridAspectRatio", "columns", "rows", "cellAspectRatio",
        "uniformContiguousGrid", "gapsAllowed", "maximumSubjectWidthPermille",
        "maximumSubjectHeightPermille", "fullOuterKeyMarginRequired", "directionRows",
        "frontBackDirectionPolicy", "leftRightDirectionPolicy", "providerInvocationEvidence"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "originKind": { "const": "provider-generation-guidance" },
        "version": { "const": "character-atlas-layout-v1" },
        "algorithm": { "const": "character-atlas-layout/exact-5x4-portrait-grid-v1" },
        "configSha256": { "const": "7ba96a82ed263de5a71a9f4969d8976fe09c71e48002427ce119b8ba7b625ee8" },
        "overallContentGridAspectRatio": { "const": "5:4" },
        "columns": { "const": 10 },
        "rows": { "const": 4 },
        "cellAspectRatio": { "const": "1:2" },
        "uniformContiguousGrid": { "const": true },
        "gapsAllowed": { "const": false },
        "maximumSubjectWidthPermille": { "const": 800 },
        "maximumSubjectHeightPermille": { "const": 880 },
        "fullOuterKeyMarginRequired": { "const": true },
        "directionRows": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "items": [
            { "const": "front" }, { "const": "back" },
            { "const": "left" }, { "const": "right" }
          ],
          "additionalItems": false
        },
        "frontBackDirectionPolicy": {
          "const": "axis-locked-all-frames-including-walk-no-profile-or-three-quarter"
        },
        "leftRightDirectionPolicy": { "const": "fixed-row-direction" },
        "providerInvocationEvidence": { "const": "unverified-no-provider-receipt" }
      }
    },
    "characterDirectionStripPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "originKind", "version", "algorithm", "configSha256",
        "stripCount", "contentAspectRatio", "columnsPerStrip", "rowsPerStrip",
        "cellAspectRatio", "uniformContiguousCells", "gapsAllowed",
        "maximumSubjectWidthPermille", "maximumSubjectHeightPermille",
        "fullOuterKeyMarginRequired", "directionOrder", "directionPolicy",
        "providerInvocationEvidence"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "originKind": { "const": "provider-generation-guidance" },
        "version": { "const": "character-direction-strip-layout-v1" },
        "algorithm": { "const": "character-direction-strip/exact-10x1-portrait-row-v1" },
        "configSha256": { "const": "12d5f69cd111e524e09c85f9cba748c18474731dbffb628923c83d39b8afa7d6" },
        "stripCount": { "const": 4 },
        "contentAspectRatio": { "const": "5:1" },
        "columnsPerStrip": { "const": 10 },
        "rowsPerStrip": { "const": 1 },
        "cellAspectRatio": { "const": "1:2" },
        "uniformContiguousCells": { "const": true },
        "gapsAllowed": { "const": false },
        "maximumSubjectWidthPermille": { "const": 800 },
        "maximumSubjectHeightPermille": { "const": 880 },
        "fullOuterKeyMarginRequired": { "const": true },
        "directionOrder": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "items": [
            { "const": "front" }, { "const": "back" },
            { "const": "left" }, { "const": "right" }
          ],
          "additionalItems": false
        },
        "directionPolicy": {
          "const": "axis-locked-all-frames-including-work-no-profile-or-three-quarter"
        },
        "providerInvocationEvidence": { "const": "unverified-no-provider-receipt" }
      }
    },
    "providerKeyNormalizationPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "originKind", "version", "algorithm", "configSha256",
        "sourceKinds", "sourceFormat", "providerInvocationEvidence"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "originKind": { "const": "deterministic-derived" },
        "version": { "const": "provider-key-normalize-v1" },
        "algorithm": { "const": "provider-key-normalize/outer-connected-exact-magenta-v1" },
        "configSha256": { "$ref": "#/definitions/sha256" },
        "sourceKinds": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": [{ "const": "identity-master" }, { "const": "monolithic-atlas" }],
          "additionalItems": false
        },
        "sourceFormat": { "const": "png" },
        "providerInvocationEvidence": { "const": "unverified-no-provider-receipt" }
      }
    },
    "terrainCompositionPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "originKind", "composerVersion", "algorithm",
        "configSha256", "maskSetSha256", "tileSize", "seamBand",
        "baseInputs", "waterMotionInputs"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "originKind": { "const": "deterministic-derived" },
        "composerVersion": { "const": "terrain-composed-atlas-v1" },
        "algorithm": { "const": "terrain-composed-atlas/shared-seam-blob16-v1" },
        "configSha256": { "$ref": "#/definitions/sha256" },
        "maskSetSha256": { "$ref": "#/definitions/sha256" },
        "tileSize": { "const": 64 },
        "seamBand": { "const": 4 },
        "baseInputs": {
          "type": "object", "additionalProperties": false,
          "required": ["minimum", "maximum", "roles"],
          "properties": {
            "minimum": { "const": 1 }, "maximum": { "const": 3 },
            "roles": {
              "type": "array", "minItems": 3, "maxItems": 3,
              "items": [{ "const": "base-0" }, { "const": "base-1" }, { "const": "base-2" }],
              "additionalItems": false
            }
          }
        },
        "waterMotionInputs": {
          "type": "object", "additionalProperties": false,
          "required": ["minimum", "maximum", "roles"],
          "properties": {
            "minimum": { "const": 0 },
            "maximum": { "enum": [0, 3] },
            "roles": {
              "oneOf": [
                { "type": "array", "maxItems": 0 },
                {
                  "type": "array", "minItems": 3, "maxItems": 3,
                  "items": [
                    { "const": "water-motion-0" },
                    { "const": "water-motion-1" },
                    { "const": "water-motion-2" }
                  ],
                  "additionalItems": false
                }
              ]
            }
          }
        }
      }
    },
    "terrainMaterialInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptedFormats", "cropShape", "minimumCropSize", "sourceAlpha",
        "forbiddenOpaqueRgb", "outputOrigin", "providerInvocationEvidence"
      ],
      "properties": {
        "acceptedFormats": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": [{ "const": "png" }, { "const": "jpeg" }, { "const": "webp" }],
          "additionalItems": false
        },
        "cropShape": { "const": "square" },
        "minimumCropSize": { "const": 64 },
        "sourceAlpha": { "const": "fully-opaque" },
        "forbiddenOpaqueRgb": { "const": "#FF00FF" },
        "outputOrigin": { "const": "deterministic-derived" },
        "providerInvocationEvidence": { "const": "unverified-no-provider-receipt" }
      }
    },
    "terrainInputPolicyOverlay": {
      "type": "object",
      "required": ["sourceLimits", "terrainMaterialInputs"],
      "properties": {
        "format": { "const": "png-jpeg-webp" },
        "nativeOutputSize": { "const": false },
        "chromaKeyColor": { "type": "null" },
        "chromaKeyTolerance": { "type": "null" },
        "canonicalBackgroundRemoval": false,
        "sourceLimits": { "$ref": "#/definitions/sourceLimits" },
        "hardAlphaThreshold": { "type": "null" },
        "hiddenRgbPolicy": { "const": "not-applicable-fully-opaque-input" },
        "assemblyKernel": { "const": "terrain-composed-atlas/shared-seam-blob16-v1" },
        "terrainMaterialInputs": { "$ref": "#/definitions/terrainMaterialInputs" }
      }
    },
    "legacyInputPolicyOverlay": {
      "type": "object",
      "properties": {
        "format": { "const": "png" },
        "nativeOutputSize": { "const": true },
        "chromaKeyColor": { "const": "#FF00FF" },
        "chromaKeyTolerance": { "const": 0 },
        "hardAlphaThreshold": { "const": 127 },
        "hiddenRgbPolicy": { "const": "zero" },
        "assemblyKernel": { "const": "raw-copy" },
        "terrainMaterialInputs": false
      }
    },
    "canonicalBackgroundRemovalPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method", "expectedKeyColor", "colorDistance", "borderMode",
        "borderBandMax", "borderSampleStrideDivisor", "rounding",
        "expectedKeyMaxDistance", "borderInlierDistance", "minimumBorderInlierPermille",
        "keyLikeDistance", "transparentDistance", "opaqueDistance",
        "keyDominanceThreshold", "spillChannelDelta", "spillChannelMinimum",
        "alphaNoiseFloor", "despill", "despillOpaqueFloor", "despillAnchorOffset",
        "hiddenRgbPolicy", "resizeKernel", "hardAlphaThreshold"
      ],
      "properties": {
        "method": {
          "enum": [
            "auto-border-soft-matte-v1",
            "auto-border-soft-matte-v2",
            "auto-border-soft-matte-v3"
          ]
        },
        "expectedKeyColor": { "const": "#FF00FF" },
        "colorDistance": { "const": "chebyshev-rgb" },
        "borderMode": { "const": "source-border" },
        "borderBandMax": { "const": 6 },
        "borderSampleStrideDivisor": { "const": 256 },
        "rounding": { "const": "nearest-ties-to-even" },
        "expectedKeyMaxDistance": { "const": 16 },
        "borderInlierDistance": { "const": 12 },
        "minimumBorderInlierPermille": { "const": 750 },
        "keyLikeDistance": { "const": 32 },
        "transparentDistance": { "const": 12 },
        "opaqueDistance": { "const": 220 },
        "keyDominanceThreshold": { "const": 16 },
        "spillChannelDelta": { "const": 16 },
        "spillChannelMinimum": { "const": 128 },
        "alphaNoiseFloor": { "const": 8 },
        "despill": { "const": true },
        "despillOpaqueFloor": { "const": 252 },
        "despillAnchorOffset": { "const": 1 },
        "hiddenRgbPolicy": { "const": "zero" },
        "resizeKernel": { "const": "nearest" },
        "hardAlphaThreshold": { "const": 127 }
      }
    },
    "sourceLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxSourcePixels", "maxUniqueSourcePixels", "maxUniqueSourceBytes"],
      "properties": {
        "maxSourcePixels": { "const": 4194304 },
        "maxUniqueSourcePixels": { "const": 67108864 },
        "maxUniqueSourceBytes": { "const": 209715200 }
      }
    },
    "expectations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected-nonempty", "semantic-transparent", "reserved-transparent"],
      "properties": {
        "expected-nonempty": { "type": "integer", "minimum": 0, "maximum": 100 },
        "semantic-transparent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "reserved-transparent": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "positiveSize": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "height": { "type": "integer", "minimum": 1, "maximum": 8192 }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "integer", "minimum": 0, "maximum": 8192 },
        "y": { "type": "integer", "minimum": 0, "maximum": 8192 }
      }
    },
    "artifactContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "fileSuffix", "outputSize", "anchor"],
      "properties": {
        "role": { "enum": ["primary", "base", "roof"] },
        "fileSuffix": { "enum": [".png", ".base.png", ".roof.png"] },
        "outputSize": { "$ref": "#/definitions/positiveSize" },
        "anchor": { "$ref": "#/definitions/point" }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256", "role", "extension"],
