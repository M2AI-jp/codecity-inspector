{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codecity-inspector.local/asset-forge/identity-master-plan-v2.schema.json",
  "title": "Fable5WaveAIdentityMasterPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "planId", "kind", "auxiliary", "semanticCell", "approvedAsset", "outputSize",
    "cellSize", "directions", "promptText", "promptSha256", "inputReferences"
  ],
  "properties": {
    "planId": { "type": "string", "pattern": "^identity_[a-f0-9]{20}$" },
    "kind": { "const": "identity-master" },
    "auxiliary": { "const": true },
    "semanticCell": { "const": false },
    "approvedAsset": { "const": false },
    "outputSize": {
      "type": "object", "additionalProperties": false, "required": ["width", "height"],
      "properties": { "width": { "const": 192 }, "height": { "const": 96 } }
    },
    "cellSize": {
      "type": "object", "additionalProperties": false, "required": ["width", "height"],
      "properties": { "width": { "const": 48 }, "height": { "const": 96 } }
    },
    "directions": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": [{ "const": "front" }, { "const": "back" }, { "const": "left" }, { "const": "right" }],
      "additionalItems": false
    },
    "promptText": { "type": "string", "minLength": 256 },
    "promptSha256": { "$ref": "#/definitions/sha256" },
    "inputReferences": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": [
        { "$ref": "#/definitions/globalReference" },
        { "$ref": "#/definitions/subjectReference" }
      ],
      "additionalItems": false
    }
  },
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "sha256", "role"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/definitions/sha256" },
        "role": { "enum": ["global-style", "primary-subject"] }
      }
    },
    "globalReference": { "allOf": [{ "$ref": "#/definitions/reference" }, { "type": "object", "properties": { "role": { "const": "global-style" } } }] },
    "subjectReference": { "allOf": [{ "$ref": "#/definitions/reference" }, { "type": "object", "properties": { "role": { "const": "primary-subject" } } }] }
  }
}
