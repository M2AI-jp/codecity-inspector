{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codecity-inspector.local/asset-forge/game-export-v3.schema.json",
  "title": "Fable5GameAssetExportV3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "scope", "requiredSet", "completeForDeclaredWaves",
    "fullFable5SetComplete", "bundleSetDigest",
    "waveAApprovalEvidence", "legacyMigration", "assets"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "scope": { "const": "wave-a-only-not-full-fable5-set" },
    "requiredSet": { "$ref": "#/definitions/requiredSet" },
    "completeForDeclaredWaves": { "const": true },
    "fullFable5SetComplete": { "const": false },
    "bundleSetDigest": { "$ref": "#/definitions/sha256" },
    "waveAApprovalEvidence": { "$ref": "#/definitions/waveAApprovalEvidence" },
    "legacyMigration": { "$ref": "#/definitions/legacyMigration" },
    "assets": {
      "type": "array",
      "minItems": 109,
      "maxItems": 109,
      "items": { "$ref": "#/definitions/asset" }
    }
  },
  "definitions": {
    "assetId": {
      "type": "string",
      "pattern": "^(character|building|terrain|overlay|structure|interior|prop|ui|effect)\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "requiredSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "waveIds", "assetCount", "minimumOutputPngCount"],
      "properties": {
        "id": { "const": "fable5-v2" },
        "waveIds": {
          "type": "array", "minItems": 1, "maxItems": 1,
          "items": { "const": "A" }
        },
        "assetCount": { "const": 109 },
        "minimumOutputPngCount": { "const": 128 }
      }
    },
    "waveAApprovalEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvalDigest", "planDigest", "selectionDigest", "legacyDispositionDigest",
        "referenceAuthorizationSha256", "evidenceCoverageDigest", "cellAuditDigest",
        "artifactSetDigest", "requiredAssetCount", "outputPngCount",
        "declaredLogicalSlotCount", "semanticCellCount", "expectedNonemptySemanticCellCount",
        "expectedTransparentSemanticCellCount", "reservedTransparentCellCount"
      ],
      "properties": {
        "approvalDigest": { "$ref": "#/definitions/sha256" },
        "planDigest": { "$ref": "#/definitions/sha256" },
        "selectionDigest": { "$ref": "#/definitions/sha256" },
        "legacyDispositionDigest": { "$ref": "#/definitions/sha256" },
        "referenceAuthorizationSha256": { "$ref": "#/definitions/sha256" },
        "evidenceCoverageDigest": { "$ref": "#/definitions/sha256" },
        "cellAuditDigest": { "$ref": "#/definitions/sha256" },
        "artifactSetDigest": { "$ref": "#/definitions/sha256" },
        "requiredAssetCount": { "const": 109 },
        "outputPngCount": { "const": 128 },
        "declaredLogicalSlotCount": { "const": 771 },
        "semanticCellCount": { "const": 708 },
        "expectedNonemptySemanticCellCount": { "const": 696 },
        "expectedTransparentSemanticCellCount": { "const": 12 },
        "reservedTransparentCellCount": { "const": 63 }
      }
    },
    "legacyMigration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordSha256", "record"],
      "properties": {
        "recordSha256": { "$ref": "#/definitions/sha256" },
        "record": { "$ref": "legacy-disposition-v3.schema.json" }
      }
    },
    "cellAuditSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declaredLogicalSlotCount", "semanticCellCount", "expectedNonemptySemanticCellCount",
        "expectedTransparentSemanticCellCount", "reservedTransparentCellCount", "cellAuditDigest"
      ],
      "properties": {
        "declaredLogicalSlotCount": { "type": "integer", "minimum": 1, "maximum": 80 },
        "semanticCellCount": { "type": "integer", "minimum": 1, "maximum": 80 },
        "expectedNonemptySemanticCellCount": { "type": "integer", "minimum": 0, "maximum": 80 },
        "expectedTransparentSemanticCellCount": { "type": "integer", "minimum": 0, "maximum": 16 },
        "reservedTransparentCellCount": { "type": "integer", "minimum": 0, "maximum": 16 },
        "cellAuditDigest": { "$ref": "#/definitions/sha256" }
      }
    },
    "artifactBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "sha256", "publicPath"],
      "properties": {
        "role": { "enum": ["primary", "base", "roof"] },
        "sha256": { "$ref": "#/definitions/sha256" },
        "publicPath": {
          "type": "string",
          "pattern": "^/assets/forge/v3/blobs/[a-f0-9]{64}\\.png$"
        }
      }
    },
    "ordinaryAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId", "category", "definitionSha256", "bundleDigest", "generationRecordDigest",
        "definition", "cellAudit", "artifacts"
      ],
      "properties": {
        "assetId": {
          "type": "string",
          "pattern": "^(character|terrain|overlay|structure|interior|prop|ui|effect)\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*$"
        },
        "category": {
          "enum": ["character", "terrain", "overlay", "structure", "interior", "prop", "ui", "effect"]
        },
        "definitionSha256": { "$ref": "#/definitions/sha256" },
        "bundleDigest": { "$ref": "#/definitions/sha256" },
        "generationRecordDigest": { "$ref": "#/definitions/sha256" },
        "definition": { "$ref": "asset-definition.schema.json" },
        "cellAudit": { "$ref": "#/definitions/cellAuditSummary" },
        "artifacts": {
          "type": "array", "minItems": 1, "maxItems": 1,
          "items": [
            {
              "allOf": [
                { "$ref": "#/definitions/artifactBase" },
                { "type": "object", "properties": { "role": { "const": "primary" } } }
              ]
            }
          ],
          "additionalItems": false
        }
      }
    },
    "buildingAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId", "category", "definitionSha256", "bundleDigest", "generationRecordDigest",
        "definition", "cellAudit", "artifacts"
      ],
      "properties": {
        "assetId": { "type": "string", "pattern": "^building\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*$" },
        "category": { "const": "building" },
        "definitionSha256": { "$ref": "#/definitions/sha256" },
        "bundleDigest": { "$ref": "#/definitions/sha256" },
        "generationRecordDigest": { "$ref": "#/definitions/sha256" },
        "definition": { "$ref": "asset-definition.schema.json" },
        "cellAudit": { "$ref": "#/definitions/cellAuditSummary" },
        "artifacts": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": [
            {
              "allOf": [
                { "$ref": "#/definitions/artifactBase" },
                { "type": "object", "properties": { "role": { "const": "base" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/definitions/artifactBase" },
                { "type": "object", "properties": { "role": { "const": "roof" } } }
              ]
            }
          ],
          "additionalItems": false
        }
      }
    },
    "asset": {
      "oneOf": [
        { "$ref": "#/definitions/ordinaryAsset" },
        { "$ref": "#/definitions/buildingAsset" }
      ]
    }
  }
}
