{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codecity-inspector.local/asset-forge/wave-a-approval-v3.schema.json",
  "title": "Fable5WaveAApprovalV3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "contract", "requiredSetId", "waveId", "status", "reviewer",
    "approvedAt", "note", "planDigest", "approvalDigest", "selectionDigest",
    "legacyDispositionDigest", "referenceAuthorizationSha256", "evidenceCoverageDigest",
    "cellAuditDigest", "artifactSetDigest", "requiredAssetCount", "outputPngCount",
    "declaredLogicalSlotCount", "semanticCellCount", "expectedNonemptySemanticCellCount",
    "expectedTransparentSemanticCellCount", "reservedTransparentCellCount",
    "bundleLedgerDigestBefore", "bundleDirectory", "assets"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "contract": { "const": "fable5-wave-approval-v3" },
    "requiredSetId": { "const": "fable5-v2" },
    "waveId": { "const": "A" },
    "status": { "const": "approved" },
    "reviewer": { "const": "human" },
    "approvedAt": { "type": "string", "format": "date-time" },
    "note": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "planDigest": { "$ref": "#/definitions/sha256" },
    "approvalDigest": { "$ref": "#/definitions/sha256" },
    "selectionDigest": { "$ref": "#/definitions/sha256" },
    "legacyDispositionDigest": { "$ref": "#/definitions/sha256" },
    "referenceAuthorizationSha256": { "$ref": "#/definitions/sha256" },
    "evidenceCoverageDigest": { "$ref": "#/definitions/sha256" },
    "cellAuditDigest": { "$ref": "#/definitions/sha256" },
    "artifactSetDigest": { "$ref": "#/definitions/sha256" },
    "requiredAssetCount": { "const": 109 },
    "outputPngCount": { "const": 128 },
    "declaredLogicalSlotCount": { "const": 771 },
    "semanticCellCount": { "const": 708 },
    "expectedNonemptySemanticCellCount": { "const": 696 },
    "expectedTransparentSemanticCellCount": { "const": 12 },
    "reservedTransparentCellCount": { "const": 63 },
    "bundleLedgerDigestBefore": { "$ref": "#/definitions/sha256" },
    "bundleDirectory": {
      "type": "string",
      "pattern": "^generated/v3/wave-bundles/[a-f0-9]{64}$"
    },
    "assets": {
      "type": "array",
      "minItems": 109,
      "maxItems": 109,
      "items": { "$ref": "#/definitions/asset" }
    }
  },
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "assetId": {
      "type": "string",
      "pattern": "^(character|building|terrain|overlay|structure|interior|prop|ui|effect)\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*$"
    },
    "generationId": { "type": "string", "pattern": "^gen_[a-z0-9][a-z0-9_-]{0,127}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "approvedPath", "sha256"],
      "properties": {
        "role": { "enum": ["primary", "base", "roof"] },
        "approvedPath": {
          "type": "string",
          "pattern": "^generated/v3/wave-bundles/[a-f0-9]{64}/[a-z0-9][a-z0-9_.-]*\\.png$"
        },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "alphaBbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactRole", "cellIndex", "frameRole", "expectation", "rgbaSha256",
        "alphaPixelCount", "hiddenRgbPixelCount", "alphaBbox"
      ],
      "properties": {
        "artifactRole": { "enum": ["primary", "base", "roof"] },
        "cellIndex": { "type": "integer", "minimum": 0, "maximum": 63 },
        "frameRole": { "type": "string", "minLength": 1, "maxLength": 160 },
        "expectation": {
          "enum": [
            "semantic-nonempty", "semantic-transparent-autotile-mask0", "reserved-transparent"
          ]
        },
        "rgbaSha256": { "$ref": "#/definitions/sha256" },
        "alphaPixelCount": { "type": "integer", "minimum": 0 },
        "hiddenRgbPixelCount": { "const": 0 },
        "alphaBbox": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/definitions/alphaBbox" }
          ]
        }
      }
    },
    "cellAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declaredLogicalSlotCount", "semanticCellCount", "expectedNonemptySemanticCellCount",
        "expectedTransparentSemanticCellCount", "reservedTransparentCellCount", "cells",
        "cellAuditDigest"
      ],
      "properties": {
        "declaredLogicalSlotCount": { "type": "integer", "minimum": 1, "maximum": 80 },
        "semanticCellCount": { "type": "integer", "minimum": 1, "maximum": 80 },
        "expectedNonemptySemanticCellCount": { "type": "integer", "minimum": 0, "maximum": 80 },
        "expectedTransparentSemanticCellCount": { "type": "integer", "minimum": 0, "maximum": 16 },
        "reservedTransparentCellCount": { "type": "integer", "minimum": 0, "maximum": 16 },
        "cells": {
          "type": "array", "minItems": 1, "maxItems": 80,
          "items": { "$ref": "#/definitions/cell" }
        },
        "cellAuditDigest": { "$ref": "#/definitions/sha256" }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId", "pendingGenerationId", "pendingGenerationRecordDigest", "definitionSha256",
        "bundleDigest", "visualEvidenceDigest", "artifacts", "cellAudit"
      ],
      "properties": {
        "assetId": { "$ref": "#/definitions/assetId" },
        "pendingGenerationId": { "$ref": "#/definitions/generationId" },
        "pendingGenerationRecordDigest": { "$ref": "#/definitions/sha256" },
        "definitionSha256": { "$ref": "#/definitions/sha256" },
        "bundleDigest": { "$ref": "#/definitions/sha256" },
        "visualEvidenceDigest": { "$ref": "#/definitions/sha256" },
        "artifacts": {
          "type": "array", "minItems": 1, "maxItems": 2,
          "items": { "$ref": "#/definitions/artifact" }
        },
        "cellAudit": { "$ref": "#/definitions/cellAudit" }
      }
    }
  }
}
