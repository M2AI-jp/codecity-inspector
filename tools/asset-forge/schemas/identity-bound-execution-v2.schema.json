{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codecity-inspector.local/asset-forge/identity-bound-execution-v2.schema.json",
  "title": "Fable5WaveAIdentityBoundUnitExecution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "requiredSetId", "waveId", "status", "bindingId",
    "jobPackPath", "jobId", "jobProvenanceKey", "assetId", "definitionSha256",
    "promptSha256", "referenceAuthorizationSha256", "generationUnitSetSha256",
    "generationMode", "identityMaster", "units", "issuanceSequence",
    "providerInvocationEvidence", "contentDigest"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "requiredSetId": { "const": "fable5-v2" },
    "waveId": { "const": "A" },
    "status": { "const": "identity-bound-unit-execution" },
    "bindingId": { "type": "string", "pattern": "^identity_binding_[a-f0-9]{20}$" },
    "jobPackPath": { "$ref": "#/definitions/jobPackPath" },
    "jobId": { "type": "string", "pattern": "^job_v2_[a-f0-9]{20}$" },
    "jobProvenanceKey": { "$ref": "#/definitions/sha256" },
    "assetId": { "type": "string", "pattern": "^character\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*$" },
    "definitionSha256": { "$ref": "#/definitions/sha256" },
    "promptSha256": { "$ref": "#/definitions/sha256" },
    "referenceAuthorizationSha256": { "$ref": "#/definitions/sha256" },
    "generationUnitSetSha256": { "$ref": "#/definitions/sha256" },
    "generationMode": { "enum": ["per-unit", "monolithic-atlas", "character-direction-strips"] },
    "characterAtlasLayoutPlan": {
      "$ref": "generation-job-v2.schema.json#/definitions/characterAtlasLayoutPlan"
    },
    "characterDirectionStripPlan": {
      "$ref": "generation-job-v2.schema.json#/definitions/characterDirectionStripPlan"
    },
    "identityMaster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planId", "planPromptSha256", "inputReferences", "sourceOriginal",
        "sourceSnapshot", "transformedSnapshot", "transformSteps",
        "consistencyInputSha256", "directionCellSha256s", "auxiliary",
        "semanticCell", "approvedAsset"
      ],
      "properties": {
        "planId": { "type": "string", "pattern": "^identity_[a-f0-9]{20}$" },
        "planPromptSha256": { "$ref": "#/definitions/sha256" },
        "inputReferences": { "$ref": "#/definitions/references" },
        "sourceOriginal": { "$ref": "#/definitions/sourceRecord" },
        "sourceSnapshot": { "$ref": "#/definitions/snapshot" },
        "providerKeyNormalization": { "$ref": "#/definitions/providerKeyNormalization" },
        "transformedSnapshot": { "$ref": "#/definitions/snapshot" },
        "transformSteps": { "$ref": "#/definitions/sourceTransformSteps" },
        "transformEvidence": {
          "$ref": "unit-assembly-v2.schema.json#/definitions/transformEvidence"
        },
        "consistencyInputSha256": { "$ref": "#/definitions/sha256" },
        "directionCellSha256s": {
          "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
          "items": { "$ref": "#/definitions/sha256" }
        },
        "auxiliary": { "const": true },
        "semanticCell": { "const": false },
        "approvedAsset": { "const": false }
      }
    },
    "atlasExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layout", "columns", "rows", "unitOrder",
        "executionPromptPath", "executionPromptSha256"
      ],
      "properties": {
        "layout": { "const": "character-row-major-directions-by-row-frames-by-column" },
        "columns": { "const": 10 },
        "rows": { "const": 4 },
        "unitOrder": {
          "type": "array", "minItems": 40, "maxItems": 40, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^unit_[a-z0-9_]+$" }
        },
        "executionPromptPath": {
          "type": "string",
          "pattern": "^generated/jobs/v2/fable5-v2/wave-a/[a-z0-9_-]+-job_v2_[a-f0-9]{20}/identity-bindings/identity_binding_[a-f0-9]{20}/execution-prompts/monolithic-atlas\\.md$"
        },
        "executionPromptSha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "directionStripExecutions": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": [
        { "allOf": [{ "$ref": "#/definitions/directionStripExecution" }, { "type": "object", "properties": { "direction": { "const": "front" } } }] },
        { "allOf": [{ "$ref": "#/definitions/directionStripExecution" }, { "type": "object", "properties": { "direction": { "const": "back" } } }] },
        { "allOf": [{ "$ref": "#/definitions/directionStripExecution" }, { "type": "object", "properties": { "direction": { "const": "left" } } }] },
        { "allOf": [{ "$ref": "#/definitions/directionStripExecution" }, { "type": "object", "properties": { "direction": { "const": "right" } } }] }
      ],
      "additionalItems": false
    },
    "units": {
      "type": "array", "minItems": 40, "maxItems": 40,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "unitId", "baseUnitPromptSha256", "executionPromptPath",
          "executionPromptSha256", "consistencyInputSha256", "inputReferences"
        ],
        "properties": {
          "unitId": { "type": "string", "pattern": "^unit_[a-z0-9_]+$" },
          "baseUnitPromptSha256": { "$ref": "#/definitions/sha256" },
          "executionPromptPath": {
            "type": "string",
            "pattern": "^generated/jobs/v2/fable5-v2/wave-a/[a-z0-9_-]+-job_v2_[a-f0-9]{20}/identity-bindings/identity_binding_[a-f0-9]{20}/execution-prompts/(?:unit_[a-z0-9_]+|monolithic-atlas|direction-strip-(?:front|back|left|right))\\.md$"
          },
          "executionPromptSha256": { "$ref": "#/definitions/sha256" },
          "consistencyInputSha256": { "$ref": "#/definitions/sha256" },
          "inputReferences": { "$ref": "#/definitions/references" }
        }
      }
    },
    "issuanceSequence": { "const": "identity-binding-before-unit-source-import" },
    "providerInvocationEvidence": { "const": "unverified-no-provider-receipt" },
    "contentDigest": { "$ref": "#/definitions/sha256" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "generationMode": { "const": "monolithic-atlas" } },
        "required": ["generationMode"]
      },
      "then": {
        "properties": { "atlasExecution": {} },
        "required": ["atlasExecution"]
      },
      "else": { "properties": { "atlasExecution": false } }
    },
    {
      "if": {
        "properties": { "generationMode": { "const": "character-direction-strips" } },
        "required": ["generationMode"]
      },
      "then": {
        "properties": {
          "characterDirectionStripPlan": {
            "$ref": "generation-job-v2.schema.json#/definitions/characterDirectionStripPlan"
          },
          "directionStripExecutions": {}
        },
        "required": ["characterDirectionStripPlan", "directionStripExecutions"]
      },
      "else": {
        "properties": { "directionStripExecutions": false },
        "not": {
          "properties": { "characterDirectionStripPlan": {} },
          "required": ["characterDirectionStripPlan"]
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "identityMaster": {
            "type": "object",
            "properties": { "providerKeyNormalization": {} },
            "required": ["providerKeyNormalization"]
          }
        },
        "required": ["identityMaster"]
      },
      "then": {
        "properties": { "generationMode": { "const": "monolithic-atlas" } }
      }
    },
    {
      "if": {
        "properties": { "characterAtlasLayoutPlan": {} },
        "required": ["characterAtlasLayoutPlan"]
      },
      "then": {
        "properties": { "generationMode": { "const": "monolithic-atlas" } }
      }
    }
  ],
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "directionStripExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction", "layout", "contentAspectRatio", "columns", "rows",
        "unitOrder", "executionPromptPath", "executionPromptSha256"
      ],
      "properties": {
        "direction": { "enum": ["front", "back", "left", "right"] },
        "layout": { "const": "character-direction-strip-frames-by-column" },
        "contentAspectRatio": { "const": "5:1" },
        "columns": { "const": 10 },
        "rows": { "const": 1 },
        "unitOrder": {
          "type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^unit_[a-z0-9_]+$" }
        },
        "executionPromptPath": {
          "type": "string",
          "pattern": "^generated/jobs/v2/fable5-v2/wave-a/[a-z0-9_-]+-job_v2_[a-f0-9]{20}/identity-bindings/identity_binding_[a-f0-9]{20}/execution-prompts/direction-strip-(?:front|back|left|right)\\.md$"
        },
        "executionPromptSha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "jobPackPath": {
      "type": "string",
      "pattern": "^generated/jobs/v2/fable5-v2/wave-a/[a-z0-9_-]+-job_v2_[a-f0-9]{20}/job-pack\\.json$"
    },
    "rect": {
      "type": "object", "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "sourceRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["sha256", "format", "width", "height", "cropRect"],
      "properties": {
        "sha256": { "$ref": "#/definitions/sha256" },
        "format": { "enum": ["png", "jpeg", "webp"] },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "cropRect": { "$ref": "#/definitions/rect" }
      }
    },
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "format", "width", "height"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/definitions/sha256" },
        "format": { "enum": ["png", "jpeg", "webp"] },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "sha256", "role"],
      "properties": {
        "id": { "type": "string" },
        "sha256": { "$ref": "#/definitions/sha256" },
        "role": { "enum": ["global-style", "primary-subject"] }
      }
    },
    "references": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": { "$ref": "#/definitions/reference" }
    },
    "sourceTransformSteps": {
      "oneOf": [
        {
          "type": "array", "minItems": 4, "maxItems": 4,
          "items": [
            { "const": "crop" }, { "const": "chroma-key-remove" },
            { "const": "nearest-downscale" }, { "const": "hard-alpha" }
          ],
          "additionalItems": false
        },
        {
          "type": "array", "minItems": 6, "maxItems": 6,
          "items": [
            { "const": "auto-border-key-detect" }, { "const": "crop" },
            { "const": "soft-matte-despill" }, { "const": "zero-hidden-rgb" },
            { "const": "nearest-downscale" },
            { "const": "hard-alpha-zero-hidden-rgb" }
          ],
          "additionalItems": false
        },
        {
          "type": "array", "minItems": 7, "maxItems": 7,
          "items": [
            { "const": "provider-key-normalize-v1" },
            { "const": "auto-border-key-detect" }, { "const": "crop" },
            { "const": "soft-matte-despill" }, { "const": "zero-hidden-rgb" },
            { "const": "nearest-downscale" },
            { "const": "hard-alpha-zero-hidden-rgb" }
          ],
          "additionalItems": false
        }
      ]
    },
    "providerKeyNormalization": {
      "type": "object", "additionalProperties": false,
      "required": [
        "sourceKind", "plan", "sourceOriginal", "normalizedSnapshot", "preBorder",
        "eligibility", "outsideMaskBeforeRgbaSha256", "outsideMaskAfterRgbaSha256",
        "outsideMaskPreserved", "postBorder",
        "providerInvocationEvidence", "derivationSha256", "replayPassed"
      ],
      "properties": {
        "sourceKind": { "const": "identity-master" },
        "plan": { "$ref": "generation-job-v2.schema.json#/definitions/providerKeyNormalizationPlan" },
        "sourceOriginal": {
          "allOf": [
            { "$ref": "#/definitions/normalizationImage" },
            {
              "type": "object",
              "properties": { "originKind": { "const": "provider-original" } },
              "not": {
                "type": "object",
                "properties": { "derivedFromSha256": {} },
                "required": ["derivedFromSha256"]
              }
            }
          ]
        },
        "normalizedSnapshot": {
          "allOf": [
            { "$ref": "#/definitions/normalizationImage" },
            {
              "type": "object", "required": ["path", "originKind", "derivedFromSha256"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "originKind": { "const": "deterministic-derived" },
                "derivedFromSha256": { "$ref": "#/definitions/sha256" }
              }
            }
          ]
        },
        "preBorder": { "$ref": "#/definitions/normalizationBorder" },
        "eligibility": { "$ref": "#/definitions/normalizationEligibility" },
        "outsideMaskBeforeRgbaSha256": { "$ref": "#/definitions/sha256" },
        "outsideMaskAfterRgbaSha256": { "$ref": "#/definitions/sha256" },
        "outsideMaskPreserved": { "const": true },
        "postBorder": { "$ref": "#/definitions/normalizationBorder" },
        "providerInvocationEvidence": { "const": "unverified-no-provider-receipt" },
        "derivationSha256": { "$ref": "#/definitions/sha256" },
        "replayPassed": { "const": true }
      }
    },
    "normalizationImage": {
      "type": "object", "additionalProperties": false,
      "required": ["originKind", "sha256", "decodedRgbaSha256", "format", "width", "height"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "originKind": { "enum": ["provider-original", "deterministic-derived"] },
        "derivedFromSha256": { "$ref": "#/definitions/sha256" },
        "sha256": { "$ref": "#/definitions/sha256" },
        "decodedRgbaSha256": { "$ref": "#/definitions/sha256" },
        "format": { "const": "png" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "normalizationBorder": {
      "type": "object", "additionalProperties": false,
      "required": [
        "detectedKeyColor", "detectedKeyExpectedDistance", "borderBand",
        "borderSampleStride", "borderSampleCount", "borderSampleSha256",
        "inlierRadius", "borderInlierCount", "borderInlierPermille"
      ],
      "properties": {
        "detectedKeyColor": { "type": "string", "pattern": "^#[A-F0-9]{6}$" },
        "detectedKeyExpectedDistance": { "type": "integer", "minimum": 0, "maximum": 255 },
        "borderBand": { "type": "integer", "minimum": 1, "maximum": 6 },
        "borderSampleStride": { "type": "integer", "minimum": 1 },
        "borderSampleCount": { "type": "integer", "minimum": 4 },
        "borderSampleSha256": { "$ref": "#/definitions/sha256" },
        "inlierRadius": { "enum": [0, 12] },
        "borderInlierCount": { "type": "integer", "minimum": 0 },
        "borderInlierPermille": { "type": "integer", "minimum": 0, "maximum": 1000 }
      }
    },
    "normalizationEligibility": {
      "type": "object", "additionalProperties": false,
      "required": [
        "eligiblePixelCount", "connectedPixelCount", "connectedPixelPermille",
        "disconnectedEligiblePixelCount", "disconnectedEligiblePermille",
        "maskSha256", "maskPixelCount", "changedPixelCount"
      ],
      "properties": {
        "eligiblePixelCount": { "type": "integer", "minimum": 1 },
        "connectedPixelCount": { "type": "integer", "minimum": 1 },
        "connectedPixelPermille": { "type": "integer", "minimum": 100, "maximum": 900 },
        "disconnectedEligiblePixelCount": { "type": "integer", "minimum": 0 },
        "disconnectedEligiblePermille": { "type": "integer", "minimum": 0, "maximum": 1 },
        "maskSha256": { "$ref": "#/definitions/sha256" },
        "maskPixelCount": { "type": "integer", "minimum": 1 },
        "changedPixelCount": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
