{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codecity-inspector.local/asset-forge/wave-a-approval-journal-v3.schema.json",
  "title": "Fable5WaveAApprovalJournalV3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "contract", "status", "approvedAt", "note", "planDigest",
    "selectionDigest", "bundleLedgerBefore", "bundleLedgerAfter", "waveApprovalDigest",
    "artifactSetDigest", "stagingDirectory", "bundleDirectory", "artifacts"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "contract": { "const": "fable5-wave-approval-journal-v3" },
    "status": { "enum": ["prepared", "committed"] },
    "approvedAt": { "type": "string", "format": "date-time" },
    "note": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "planDigest": { "$ref": "#/definitions/sha256" },
    "selectionDigest": { "$ref": "#/definitions/sha256" },
    "bundleLedgerBefore": { "$ref": "#/definitions/sha256" },
    "bundleLedgerAfter": { "$ref": "#/definitions/sha256" },
    "waveApprovalDigest": { "$ref": "#/definitions/sha256" },
    "artifactSetDigest": { "$ref": "#/definitions/sha256" },
    "stagingDirectory": {
      "type": "string", "pattern": "^generated/v3/wave-staging/[a-f0-9]{64}$"
    },
    "bundleDirectory": {
      "type": "string", "pattern": "^generated/v3/wave-bundles/[a-f0-9]{64}$"
    },
    "artifacts": {
      "type": "array", "minItems": 128, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["relativeName", "sha256"],
        "properties": {
          "relativeName": {
            "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*\\.png$"
          },
          "sha256": { "$ref": "#/definitions/sha256" }
        }
      }
    }
  },
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
