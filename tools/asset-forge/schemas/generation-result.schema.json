{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codecity-inspector.local/asset-forge/generation-result.schema.json",
  "title": "GenerationResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "jobId", "assetId", "category", "status", "provider", "metadataPath",
    "promptHash", "provenanceKey", "referenceImageIds", "referenceImageHashes", "dryRun",
    "subscriptionRun", "manualImport", "warnings", "createdAt", "inspection"
  ],
  "properties": {
    "visualContractVersion": { "enum": [1, 2] },
    "requiredSetId": { "const": "fable5-v2" },
    "waveId": { "const": "A" },
    "definitionSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "assetDefinitionSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "referenceAuthorizationSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "id": { "type": "string", "minLength": 1 },
    "jobId": { "type": "string", "minLength": 1 },
    "assetId": { "type": "string", "minLength": 1 },
    "category": {
      "enum": [
        "character", "building", "field", "object", "ui", "effect",
        "terrain", "overlay", "structure", "interior", "prop"
      ]
    },
    "status": { "enum": ["pending", "failed", "job-pack", "rejected", "approved"] },
    "provider": { "enum": ["mock", "job-pack", "manual-import", "codex-subscription"] },
    "outputPath": {
      "type": "string",
      "pattern": "^(generated/(characters|buildings|fields|objects|ui|effects|terrains|overlays|structures|interiors|props)/(pending|rejected|approved)|processed/(characters|buildings|fields|objects|ui|effects|terrains|overlays|structures|interiors|props)/pending)/[a-z0-9_-]+\\.png$"
    },
    "outputSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "metadataPath": { "type": "string", "minLength": 1 },
    "promptHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "provenanceKey": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "referenceImageIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "referenceImageHashes": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "dryRun": { "type": "boolean" },
    "subscriptionRun": { "type": "boolean" },
    "manualImport": { "type": "boolean" },
    "sourcePath": {
      "type": "string",
      "pattern": "^generated/(characters|buildings|fields|objects|ui|effects|terrains|overlays|structures|interiors|props)/pending/[a-z0-9_-]+\\.source\\.(png|jpg|webp)$"
    },
    "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceFormat": { "enum": ["png", "jpeg", "webp"] },
    "processedFromGenerationId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "outputInspection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "width", "height", "channels", "frames", "bytes"],
      "properties": {
        "format": { "const": "png" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "channels": { "type": "integer", "minimum": 1, "maximum": 4 },
        "frames": { "type": "integer", "minimum": 1 },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "outputArtifacts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": [
        {
          "allOf": [
            { "$ref": "#/definitions/outputArtifact" },
            { "type": "object", "properties": { "role": { "const": "base" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/definitions/outputArtifact" },
            { "type": "object", "properties": { "role": { "const": "roof" } } }
          ]
        }
      ],
      "additionalItems": false
    },
    "technicalInspection": { "$ref": "#/definitions/technicalInspection" },
    "bundleTechnicalInspection": { "$ref": "#/definitions/bundleTechnicalInspection" },
    "productionRecipesV2": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": { "$ref": "#/definitions/productionRecipeV2" }
    },
    "unitAssemblyV2": { "$ref": "unit-assembly-v2.schema.json" },
    "sourceJobPackPathV2": {
      "type": "string",
      "pattern": "^generated/jobs/v2/fable5-v2/wave-a/[a-z0-9_-]+-job_v2_[a-f0-9]{20}/job-pack\\.json$"
    },
    "jobPackPath": { "type": "string" },
    "error": { "type": "string" },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "createdAt": { "type": "string", "format": "date-time" },
    "rejection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "rejectedAt"],
      "properties": {
        "reason": { "type": "string", "minLength": 1 },
        "rejectedAt": { "type": "string", "format": "date-time" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "note", "approvedAt", "approvedPath", "approvedSha256"],
      "properties": {
        "reviewer": { "const": "human" },
        "note": { "type": "string", "minLength": 1 },
        "approvedAt": { "type": "string", "format": "date-time" },
        "approvedPath": { "type": "string", "pattern": "^generated/(characters|buildings|fields|objects|ui|effects|terrains|overlays|structures|interiors|props)/approved/[a-z0-9_-]+\\.png$" },
        "approvedSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "productionRecipe": { "$ref": "#/definitions/productionRecipe" },
    "inspection": { "$ref": "#/definitions/inspection" }
  },
  "allOf": [
    {
      "if": {
        "allOf": [
          { "properties": { "status": { "const": "pending" } }, "required": ["status"] },
          { "not": {
            "properties": {
              "requiredSetId": { "const": "fable5-v2" },
              "category": { "const": "building" }
            },
            "required": ["requiredSetId", "category"]
          } }
        ]
      },
      "then": {
        "properties": { "outputPath": {}, "outputSha256": {}, "outputInspection": {} },
        "required": ["outputPath", "outputSha256", "outputInspection"],
        "not": { "anyOf": [
          { "properties": { "approval": {} }, "required": ["approval"] },
          { "properties": { "rejection": {} }, "required": ["rejection"] },
          { "properties": { "error": {} }, "required": ["error"] },
          { "properties": { "jobPackPath": {} }, "required": ["jobPackPath"] }
        ] }
      }
    },
    {
      "if": { "properties": { "status": { "const": "failed" } } },
      "then": {
        "properties": { "error": {} }, "required": ["error"],
        "not": { "anyOf": [
          { "properties": { "approval": {} }, "required": ["approval"] },
          { "properties": { "rejection": {} }, "required": ["rejection"] },
          { "properties": { "jobPackPath": {} }, "required": ["jobPackPath"] },
          { "properties": { "outputPath": {} }, "required": ["outputPath"] },
          { "properties": { "outputSha256": {} }, "required": ["outputSha256"] },
          { "properties": { "outputInspection": {} }, "required": ["outputInspection"] }
        ] }
      }
    },
    {
      "if": { "properties": { "status": { "const": "job-pack" } } },
      "then": {
        "properties": { "jobPackPath": {} }, "required": ["jobPackPath"],
        "not": { "anyOf": [
          { "properties": { "approval": {} }, "required": ["approval"] },
          { "properties": { "rejection": {} }, "required": ["rejection"] },
          { "properties": { "error": {} }, "required": ["error"] },
          { "properties": { "outputPath": {} }, "required": ["outputPath"] },
          { "properties": { "outputSha256": {} }, "required": ["outputSha256"] },
          { "properties": { "outputInspection": {} }, "required": ["outputInspection"] }
        ] }
      }
    },
    {
      "if": { "properties": { "status": { "const": "rejected" } } },
      "then": {
        "properties": { "outputPath": {}, "outputSha256": {}, "rejection": {} },
        "required": ["outputPath", "outputSha256", "rejection"],
        "not": { "anyOf": [
          { "properties": { "approval": {} }, "required": ["approval"] },
          { "properties": { "error": {} }, "required": ["error"] },
          { "properties": { "jobPackPath": {} }, "required": ["jobPackPath"] }
        ] }
      }
    },
    {
      "if": { "properties": { "status": { "const": "approved" } } },
      "then": {
        "properties": { "outputPath": {}, "outputSha256": {}, "approval": {} },
        "required": ["outputPath", "outputSha256", "approval"],
        "not": { "anyOf": [
          { "properties": { "rejection": {} }, "required": ["rejection"] },
          { "properties": { "error": {} }, "required": ["error"] },
          { "properties": { "jobPackPath": {} }, "required": ["jobPackPath"] }
        ] }
      }
    },
    {
      "if": {
        "allOf": [
          { "properties": { "provider": { "const": "manual-import" } }, "required": ["provider"] },
          { "not": { "properties": { "requiredSetId": { "const": "fable5-v2" } }, "required": ["requiredSetId"] } }
        ]
      },
      "then": {
        "properties": { "manualImport": { "const": true }, "sourcePath": {}, "sourceSha256": {}, "sourceFormat": {} },
        "required": ["sourcePath", "sourceSha256", "sourceFormat"]
      }
    },
    {
      "if": { "not": { "properties": { "provider": { "const": "manual-import" } } } },
      "then": { "properties": { "manualImport": { "const": false } } }
    },
    {
      "if": {
        "properties": { "requiredSetId": { "const": "fable5-v2" } },
        "required": ["requiredSetId"]
      },
      "then": {
        "properties": {
          "visualContractVersion": { "const": 2 },
          "waveId": { "const": "A" },
          "definitionSha256": {},
          "assetDefinitionSha256": {},
          "referenceAuthorizationSha256": {}
        },
        "required": [
          "visualContractVersion", "waveId", "definitionSha256",
          "assetDefinitionSha256", "referenceAuthorizationSha256"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "requiredSetId": { "const": "fable5-v2" },
          "status": { "const": "pending" }
        },
        "required": ["requiredSetId", "status"]
      },
      "then": {
        "properties": {
          "manualImport": { "const": true },
          "sourceJobPackPathV2": {},
          "productionRecipesV2": {},
          "unitAssemblyV2": {}
        },
        "required": ["sourceJobPackPathV2", "productionRecipesV2", "unitAssemblyV2"]
      }
    },
    {
      "if": {
        "properties": {
          "requiredSetId": { "const": "fable5-v2" },
          "status": { "const": "pending" },
          "category": { "const": "building" }
        },
        "required": ["requiredSetId", "status", "category"]
      },
      "then": {
        "properties": {
          "outputArtifacts": {},
          "bundleTechnicalInspection": {},
          "productionRecipesV2": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": [
              { "allOf": [
                { "$ref": "#/definitions/productionRecipeV2" },
                { "type": "object", "properties": { "role": { "const": "base" } } }
              ] },
              { "allOf": [
                { "$ref": "#/definitions/productionRecipeV2" },
                { "type": "object", "properties": { "role": { "const": "roof" } } }
              ] }
            ],
            "additionalItems": false
          }
        },
        "required": ["outputArtifacts", "bundleTechnicalInspection"],
        "not": {
          "anyOf": [
            { "properties": { "outputPath": {} }, "required": ["outputPath"] },
            { "properties": { "outputSha256": {} }, "required": ["outputSha256"] },
            { "properties": { "outputInspection": {} }, "required": ["outputInspection"] },
            { "properties": { "technicalInspection": {} }, "required": ["technicalInspection"] }
          ]
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "requiredSetId": { "const": "fable5-v2" },
              "status": { "const": "pending" }
            },
            "required": ["requiredSetId", "status"]
          },
          { "not": { "properties": { "category": { "const": "building" } }, "required": ["category"] } }
        ]
      },
      "then": {
        "properties": {
          "outputPath": {},
          "outputSha256": {},
          "outputInspection": {},
          "technicalInspection": {},
          "productionRecipesV2": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": [
              { "allOf": [
                { "$ref": "#/definitions/productionRecipeV2" },
                { "type": "object", "properties": { "role": { "const": "primary" } } }
              ] }
            ],
            "additionalItems": false
          }
        },
        "required": ["outputPath", "outputSha256", "outputInspection", "technicalInspection"],
        "not": {
          "anyOf": [
            { "properties": { "outputArtifacts": {} }, "required": ["outputArtifacts"] },
            {
              "properties": { "bundleTechnicalInspection": {} },
              "required": ["bundleTechnicalInspection"]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "approved" }, "productionRecipe": {} },
        "required": ["productionRecipe"]
      },
      "then": {
        "properties": {
          "productionRecipe": {
            "type": "object",
            "properties": {
              "sourceSnapshot": {
                "type": "object",
                "properties": {
                  "path": { "type": "string", "pattern": "^generated/(characters|buildings|fields|objects|ui|effects|terrains|overlays|structures|interiors|props)/approved/[a-z0-9_-]+\\.source-original\\.(png|jpg|webp)$" }
                }
              }
            },
            "required": ["sourceSnapshot"]
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "pending" } }, "required": ["status"] },
      "then": {
        "properties": {
          "productionRecipe": {
            "type": "object",
            "properties": {
              "sourceSnapshot": {
                "type": "object",
                "properties": {
                  "path": { "type": "string", "pattern": "^generated/(characters|buildings|fields|objects|ui|effects|terrains|overlays|structures|interiors|props)/pending/sources/[a-z0-9_-]+\\.source-original\\.(png|jpg|webp)$" }
                }
              }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "positiveSize": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "outputArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256", "inspection"],
      "properties": {
        "role": { "enum": ["base", "roof"] },
        "path": {
          "type": "string",
          "pattern": "^(generated|processed)/(characters|buildings|fields|objects|ui|effects|terrains|overlays|structures|interiors|props)/(pending|rejected|approved)/[a-z0-9_.-]+\\.png$"
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "inspection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "width", "height", "channels", "frames", "bytes"],
          "properties": {
            "format": { "const": "png" },
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "channels": { "type": "integer", "minimum": 1, "maximum": 4 },
            "frames": { "const": 1 },
            "bytes": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "technicalInspection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visualContractVersion", "alpha", "exactSeams", "resize", "cells"],
      "properties": {
        "visualContractVersion": { "const": 2 },
        "alpha": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subjectBbox", "opaquePixels", "transparentPixels", "hiddenRgbPixels",
            "partialAlphaPixels", "borderVisiblePixels", "passed"
          ],
          "properties": {
            "subjectBbox": { "$ref": "#/definitions/rect" },
            "opaquePixels": { "type": "integer", "minimum": 1 },
            "transparentPixels": { "type": "integer", "minimum": 1 },
            "hiddenRgbPixels": { "const": 0 },
            "partialAlphaPixels": { "const": 0 },
            "borderVisiblePixels": { "type": "integer", "minimum": 0 },
            "passed": { "const": true }
          }
        },
        "exactSeams": {
          "type": "object",
          "additionalProperties": false,
          "required": ["checkedTileIndices", "mismatchCount", "passed"],
          "properties": {
            "checkedTileIndices": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "integer", "minimum": 0 }
            },
            "mismatchCount": { "const": 0 },
            "passed": { "const": true }
          }
        },
        "resize": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kernel", "source", "output", "enlarged", "passed"],
          "properties": {
            "kernel": { "const": "nearest" },
            "source": { "$ref": "#/definitions/positiveSize" },
            "output": { "$ref": "#/definitions/positiveSize" },
            "enlarged": { "const": false },
            "passed": { "const": true }
          }
        },
        "cells": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "declaredSlots", "semanticCells", "expectedNonempty",
            "expectedTransparentSemantic", "reservedTransparent", "records", "passed"
          ],
          "properties": {
            "declaredSlots": { "type": "integer", "minimum": 1, "maximum": 100 },
            "semanticCells": { "type": "integer", "minimum": 1, "maximum": 100 },
            "expectedNonempty": { "type": "integer", "minimum": 1, "maximum": 100 },
            "expectedTransparentSemantic": { "type": "integer", "minimum": 0, "maximum": 100 },
            "reservedTransparent": { "type": "integer", "minimum": 0, "maximum": 100 },
            "records": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["index", "role", "expectation", "sha256", "visiblePixels"],
                "properties": {
                  "index": { "type": "integer", "minimum": 0, "maximum": 99 },
                  "role": { "type": "string", "minLength": 1 },
                  "expectation": {
                    "enum": ["nonempty", "semantic-transparent", "reserved-transparent"]
                  },
                  "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                  "visiblePixels": { "type": "integer", "minimum": 0 }
                }
              }
            },
            "passed": { "const": true }
          }
        }
      }
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "bundleTechnicalInspection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visualContractVersion", "atomicPair", "roles", "artifacts", "passed"],
      "properties": {
        "visualContractVersion": { "const": 2 },
        "atomicPair": { "const": true },
        "roles": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": [{ "const": "base" }, { "const": "roof" }],
          "additionalItems": false
        },
        "artifacts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["role", "technicalInspection"],
              "properties": {
                "role": { "const": "base" },
                "technicalInspection": { "$ref": "#/definitions/technicalInspection" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["role", "technicalInspection"],
              "properties": {
                "role": { "const": "roof" },
                "technicalInspection": { "$ref": "#/definitions/technicalInspection" }
              }
            }
          ],
          "additionalItems": false
        },
        "passed": { "const": true }
      }
    },
    "productionRecipeV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role", "method", "generator", "toolMode", "transformSteps", "promptSnapshot",
        "inputReferences", "sourceOriginal", "artifact"
      ],
      "allOf": [
        {
          "if": {
            "properties": { "method": { "const": "imagegen" } },
            "required": ["method"]
          },
          "then": {
            "properties": {
              "generator": { "const": "codex-imagegen-built-in" },
              "sourceOriginal": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^generated/(characters|buildings|terrains|overlays|structures|interiors|props|ui|effects)/pending/sources/[a-z0-9_-]+\\.source-original\\.(png|jpg|webp)$"
                  },
                  "originKind": false,
                  "derivedFromSha256s": false,
                  "derivationSha256": false
                }
              }
            }
          },
          "else": {
            "if": {
              "properties": { "method": { "const": "terrain-composition" } },
              "required": ["method"]
            },
            "then": {
              "properties": {
                "generator": { "const": "codecity-terrain-composer-v1" },
                "sourceOriginal": {
                  "type": "object",
                  "properties": {
                    "originKind": { "const": "deterministic-derived" },
                    "derivedFromSha256s": {
                      "type": "array", "minItems": 1, "maxItems": 6,
                      "uniqueItems": true,
                      "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                    },
                    "derivationSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                  },
                  "required": ["originKind", "derivedFromSha256s", "derivationSha256"]
                }
              }
            },
            "else": {
              "properties": {
                "generator": { "const": "codecity-unit-assembler-v2" },
                "sourceOriginal": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "pattern": "^generated/(characters|buildings|terrains|overlays|structures|interiors|props|ui|effects)/pending/sources/[a-z0-9_-]+\\.source-original\\.(png|jpg|webp)$"
                    },
                    "originKind": false,
                    "derivedFromSha256s": false,
                    "derivationSha256": false
                  }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "role": { "enum": ["primary", "base", "roof"] },
        "method": { "enum": ["imagegen", "unit-assembly", "terrain-composition"] },
        "generator": {
          "enum": [
            "codex-imagegen-built-in", "codecity-unit-assembler-v2", "codecity-terrain-composer-v1"
          ]
        },
        "toolMode": { "const": "built-in" },
        "transformSteps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "none", "crop", "chroma-key-remove", "nearest-downscale", "hard-alpha"
            ]
          }
        },
        "cropRect": { "$ref": "#/definitions/rect" },
        "chromaKey": {
          "type": "object",
          "additionalProperties": false,
          "required": ["keyColor", "tolerance"],
          "properties": {
            "keyColor": { "type": "string", "pattern": "^#[a-fA-F0-9]{6}$" },
            "tolerance": { "type": "integer", "minimum": 0, "maximum": 255 }
          }
        },
        "alphaThreshold": { "type": "integer", "minimum": 0, "maximum": 255 },
        "promptSnapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^generated/jobs/v2/fable5-v2/wave-a/[a-z0-9_-]+-job_v2_[a-f0-9]{20}/prompt\\.md$"
            },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "inputReferences": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": [
            {
              "allOf": [
                { "$ref": "#/definitions/inputReferenceV2" },
                { "type": "object", "properties": { "role": { "const": "global-style" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/definitions/inputReferenceV2" },
                { "type": "object", "properties": { "role": { "const": "primary-subject" } } }
              ]
            }
          ],
          "additionalItems": false
        },
        "sourceOriginal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "format", "width", "height"],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^generated/(characters|buildings|terrains|overlays|structures|interiors|props|ui|effects)/pending/sources/[a-z0-9_-]+\\.(?:source-original\\.(?:png|jpg|webp)|derived-composition\\.png)$"
            },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "format": { "enum": ["png", "jpeg", "webp"] },
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "originKind": { "const": "deterministic-derived" },
            "derivedFromSha256s": {
              "type": "array", "minItems": 1, "maxItems": 6,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            },
            "derivationSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "width", "height"],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^generated/(characters|buildings|terrains|overlays|structures|interiors|props|ui|effects)/pending/[a-z0-9_-]+\\.png$"
            },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "inputReferenceV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256", "role"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "role": { "enum": ["global-style", "primary-subject"] }
      }
    },
    "productionRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "waveId", "assetId", "method", "generator", "scaleClass", "referenceImages",
        "source", "backgroundRemoval", "canvas", "subjectBbox", "outputSha256"
      ],
      "allOf": [
        {
          "if": { "properties": { "method": { "const": "imagegen" } }, "required": ["method"] },
          "then": {
            "required": ["generationPromptPath", "generationPromptSha256", "toolMode", "inputReferences"],
            "properties": {
              "generationPromptPath": {},
              "generationPromptSha256": {},
              "toolMode": {},
              "inputReferences": {}
            }
          }
        },
        {
          "if": { "properties": { "method": { "const": "direct-extraction" } }, "required": ["method"] },
          "then": {
            "required": ["transformSteps", "orientationContract"],
            "properties": {
              "transformSteps": {},
              "orientationContract": {},
              "source": {
                "type": "object",
                "properties": { "cropRect": { "$ref": "#/definitions/rect" } }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "assetId": { "type": "string", "pattern": "^character\\." },
              "method": { "const": "imagegen" }
            },
            "required": ["assetId", "method"]
          },
          "then": {
            "required": ["transformSteps", "spriteContract"],
            "properties": {
              "transformSteps": {},
              "spriteContract": {}
            }
          }
        },
        {
          "if": {
            "properties": {
              "assetId": { "type": "string", "pattern": "^effect\\." },
              "method": { "const": "imagegen" }
            },
            "required": ["assetId", "method"]
          },
          "then": {
            "required": ["transformSteps", "effectContract"],
            "properties": {
              "transformSteps": {},
              "effectContract": {}
            }
          }
        }
      ],
      "properties": {
        "waveId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
        "assetId": { "type": "string", "minLength": 1 },
        "method": { "enum": ["imagegen", "direct-extraction"] },
        "generator": { "type": "string", "minLength": 1 },
        "scaleClass": {
          "enum": [
            "tiny", "small", "medium", "large", "landmark",
            "S", "M", "L", "XL", "tower", "rowhouse_s", "rowhouse_l",
            "terrain", "character", "structure", "overlay_s", "overlay_m", "overlay_l", "overlay_xl",
            "interior", "prop32", "prop64", "prop_tall", "effect32", "effect64", "ui"
          ]
        },
        "generationPromptPath": {
          "type": "string",
          "pattern": "^review/prompts/[a-z0-9][a-z0-9/_-]+\\.txt$"
        },
        "generationPromptSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "toolMode": { "const": "built-in" },
        "orientationContract": { "type": "string", "minLength": 1 },
        "transformSteps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "full-frame", "crop", "nearest-downscale", "palette-quantize",
              "wrap-edge-reconcile", "grass-background-composite", "chroma-key-remove",
              "cell-extract", "shared-scale-normalize", "hard-alpha", "column-reorder"
            ]
          }
        },
    "spriteContract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "frame", "sourceColumnOrderObserved", "normalizedColumnOrder", "normalizedColumnSources",
            "rowOrder", "commonFootBaseline", "visibleBboxHeight", "resizeKernel",
            "allowEnlargement", "partialAlphaPixels"
          ],
          "properties": {
            "frame": {
              "type": "object",
              "additionalProperties": false,
              "required": ["width", "height"],
              "properties": { "width": { "const": 24 }, "height": { "const": 40 } }
            },
            "sourceColumnOrderObserved": {
              "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
              "items": { "enum": ["front", "back", "left", "right"] }
            },
            "normalizedColumnOrder": {
              "type": "array", "minItems": 4, "maxItems": 4,
              "items": [{ "const": "front" }, { "const": "back" }, { "const": "left" }, { "const": "right" }],
              "additionalItems": false
            },
            "normalizedColumnSources": {
              "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
              "items": { "type": "integer", "minimum": 0, "maximum": 3 }
            },
            "rowOrder": {
              "type": "array", "minItems": 3, "maxItems": 3,
              "items": [{ "const": "idle" }, { "const": "walk1" }, { "const": "walk2" }],
              "additionalItems": false
            },
            "commonFootBaseline": { "const": true },
            "visibleBboxHeight": {
              "type": "object", "additionalProperties": false,
              "required": ["class", "min", "max", "target"],
              "properties": {
                "class": { "enum": ["adult", "elder", "child"] },
                "min": { "type": "integer", "minimum": 1, "maximum": 40 },
                "max": { "type": "integer", "minimum": 1, "maximum": 40 },
                "target": { "type": "integer", "minimum": 1, "maximum": 40 }
              }
            },
            "resizeKernel": { "const": "nearest" },
            "allowEnlargement": { "const": false },
            "partialAlphaPixels": { "const": 0 }
          }
        },
        "effectContract": { "$ref": "#/definitions/effectContract" },
        "inputReferences": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "sha256", "role"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "role": { "enum": ["global-style", "primary-subject"] }
            }
          }
        },
        "referenceImages": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "sha256"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "width", "height", "cropRect"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "cropRect": { "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/rect" }] },
            "comparisonRect": { "$ref": "#/definitions/rect" }
          }
        },
        "sourceSnapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "width", "height"],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^generated/(characters|buildings|fields|objects|ui|effects|terrains|overlays|structures|interiors|props)/(approved|pending/sources)/[a-z0-9_-]+\\.source-original\\.(png|jpg|webp)$"
            },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          }
        },
        "compositeMask": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path", "sha256", "width", "height", "backgroundAssetId",
            "backgroundPath", "backgroundSha256"
          ],
          "properties": {
            "path": { "type": "string", "pattern": "^tmp/imagegen/[a-z0-9/_-]+\\.png$" },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "backgroundAssetId": { "const": "field.grass" },
            "backgroundPath": { "type": "string", "pattern": "^tmp/imagegen/[a-z0-9/_-]+\\.png$" },
            "backgroundSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "backgroundRemoval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method", "keyColor", "autoKey", "softMatte", "transparentThreshold",
            "opaqueThreshold", "despill", "cleanup"
          ],
          "properties": {
            "method": { "enum": ["official-chroma-key-helper", "none"] },
            "keyColor": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^#[a-fA-F0-9]{6}$" }] },
            "autoKey": { "oneOf": [{ "type": "null" }, { "const": "border" }] },
            "softMatte": { "type": "boolean" },
            "transparentThreshold": { "type": "integer", "minimum": 0, "maximum": 255 },
            "opaqueThreshold": { "type": "integer", "minimum": 0, "maximum": 255 },
            "despill": { "type": "boolean" },
            "cleanup": {
              "type": "object",
              "additionalProperties": false,
              "required": ["alphaCutoff", "componentMinPixels", "targetMaxWidth", "targetMaxHeight", "resizeKernel"],
              "properties": {
                "alphaCutoff": { "type": "integer", "minimum": 0, "maximum": 255 },
                "componentMinPixels": { "type": "integer", "minimum": 1 },
                "targetMaxWidth": { "type": "integer", "minimum": 1 },
                "targetMaxHeight": { "type": "integer", "minimum": 1 },
                "resizeKernel": { "const": "nearest" }
              }
            }
          }
        },
        "canvas": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height", "baselineY"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "baselineY": { "type": "integer", "minimum": 0 }
          }
        },
        "subjectBbox": { "$ref": "#/definitions/rect" },
        "outputSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "effectContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame",
        "grid",
        "frameOrder",
        "segmentation",
        "sourceSlices",
        "sharedScale",
        "alignment",
        "resizeKernel",
        "allowEnlargement",
        "partialAlphaPixels"
      ],
      "properties": {
        "frame": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "const": 32 },
            "height": { "const": 32 }
          }
        },
        "grid": {
          "type": "object",
          "additionalProperties": false,
          "required": ["columns", "rows"],
          "properties": {
            "columns": { "const": 4 },
            "rows": { "const": 1 }
          }
        },
        "frameOrder": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": [
            { "const": "frame_1" },
            { "const": "frame_2" },
            { "const": "frame_3" },
            { "const": "frame_4" }
          ],
          "additionalItems": false
        },
        "segmentation": { "const": "explicit-transparent-gutters" },
        "sourceSlices": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["frame", "rect", "transparentMargins"],
            "properties": {
              "frame": { "type": "integer", "minimum": 1, "maximum": 4 },
              "rect": { "$ref": "#/definitions/rect" },
              "transparentMargins": {
                "type": "object",
                "additionalProperties": false,
                "required": ["left", "right", "top", "bottom"],
                "properties": {
                  "left": { "type": "integer", "minimum": 1 },
                  "right": { "type": "integer", "minimum": 1 },
                  "top": { "type": "integer", "minimum": 1 },
                  "bottom": { "type": "integer", "minimum": 1 }
                }
              }
            }
          }
        },
        "sharedScale": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "alignment": { "enum": ["bottom", "center"] },
        "resizeKernel": { "const": "nearest" },
        "allowEnlargement": { "const": false },
        "partialAlphaPixels": { "const": 0 }
      }
    },
    "inspection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observed", "inferred", "unknown"],
      "properties": {
        "status": { "const": "pending-inspection" },
        "observed": { "type": "array", "items": { "type": "string" } },
        "inferred": { "type": "array", "items": { "type": "string" } },
        "unknown": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
