{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codecity-inspector.local/asset-forge/asset-bundle-approval.schema.json",
  "title": "Fable5AssetBundleApprovalLedger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requiredSetId", "approvals", "supersessions", "waveApprovals"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "requiredSetId": { "const": "fable5-v2" },
    "approvals": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/definitions/approval" }
    },
    "supersessions": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/definitions/supersession" }
    },
    "waveApprovals": {
      "type": "array",
      "maxItems": 2,
      "items": { "$ref": "wave-a-approval-v3.schema.json" }
    }
  },
  "definitions": {
    "assetId": {
      "type": "string",
      "pattern": "^(character|building|terrain|overlay|structure|interior|prop|ui|effect)\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generationId": {
      "type": "string",
      "pattern": "^gen_[a-z0-9][a-z0-9_-]{0,127}$"
    },
    "approvedPath": {
      "type": "string",
      "oneOf": [
        {
          "pattern": "^generated/(characters|buildings|terrains|overlays|structures|interiors|props|ui|effects)/approved/[a-z0-9][a-z0-9_.-]*\\.png$"
        },
        {
          "pattern": "^generated/v3/wave-bundles/[a-f0-9]{64}/[a-z0-9][a-z0-9_.-]*\\.png$"
        }
      ]
    },
    "artifactBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "generationId", "approvedPath", "sha256"],
      "properties": {
        "role": { "enum": ["primary", "base", "roof"] },
        "generationId": { "$ref": "#/definitions/generationId" },
        "approvedPath": { "$ref": "#/definitions/approvedPath" },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "ordinaryApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId", "category", "definitionSha256", "generationRecordDigest", "bundleDigest", "artifacts",
        "reviewer", "note", "approvedAt"
      ],
      "properties": {
        "assetId": {
          "type": "string",
          "pattern": "^(character|terrain|overlay|structure|interior|prop|ui|effect)\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*$"
        },
        "category": {
          "enum": ["character", "terrain", "overlay", "structure", "interior", "prop", "ui", "effect"]
        },
        "definitionSha256": { "$ref": "#/definitions/sha256" },
        "generationRecordDigest": { "$ref": "#/definitions/sha256" },
        "bundleDigest": { "$ref": "#/definitions/sha256" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": [
            {
              "allOf": [
                { "$ref": "#/definitions/artifactBase" },
                { "type": "object", "properties": { "role": { "const": "primary" } } }
              ]
            }
          ],
          "additionalItems": false
        },
        "reviewer": { "const": "human" },
        "note": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "approvedAt": { "type": "string", "format": "date-time" }
      }
    },
    "buildingApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId", "category", "definitionSha256", "generationRecordDigest", "bundleDigest", "artifacts",
        "reviewer", "note", "approvedAt"
      ],
      "properties": {
        "assetId": {
          "type": "string",
          "pattern": "^building\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*$"
        },
        "category": { "const": "building" },
        "definitionSha256": { "$ref": "#/definitions/sha256" },
        "generationRecordDigest": { "$ref": "#/definitions/sha256" },
        "bundleDigest": { "$ref": "#/definitions/sha256" },
        "artifacts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": [
            {
              "allOf": [
                { "$ref": "#/definitions/artifactBase" },
                { "type": "object", "properties": { "role": { "const": "base" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/definitions/artifactBase" },
                { "type": "object", "properties": { "role": { "const": "roof" } } }
              ]
            }
          ],
          "additionalItems": false
        },
        "reviewer": { "const": "human" },
        "note": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "approvedAt": { "type": "string", "format": "date-time" }
      }
    },
    "approval": {
      "oneOf": [
        { "$ref": "#/definitions/ordinaryApproval" },
        { "$ref": "#/definitions/buildingApproval" }
      ]
    },
    "supersession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId", "category", "supersededBundleDigest", "replacementBundleDigest",
        "reviewer", "note", "supersededAt", "supersessionDigest"
      ],
      "properties": {
        "assetId": { "$ref": "#/definitions/assetId" },
        "category": {
          "enum": ["character", "building", "terrain", "overlay", "structure", "interior", "prop", "ui", "effect"]
        },
        "supersededBundleDigest": { "$ref": "#/definitions/sha256" },
        "replacementBundleDigest": { "$ref": "#/definitions/sha256" },
        "reviewer": { "const": "human" },
        "note": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "supersededAt": { "type": "string", "format": "date-time" },
        "supersessionDigest": { "$ref": "#/definitions/sha256" }
      }
    }
  }
}
