{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codecity-inspector.local/asset-forge/generation-unit-v2.schema.json",
  "title": "Fable5WaveAGenerationUnit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "unitId", "artifactRole", "artifactOutputSize", "cellIndex", "frameId",
    "semanticRole", "targetRect", "expectation", "sourceRequired", "visualContent",
    "generationMode", "unitPromptText", "unitPromptSha256", "inputReferences"
  ],
  "properties": {
    "unitId": { "type": "string", "pattern": "^unit_[0-9]{3}_(primary|base|roof)_[a-z0-9_]+$" },
    "artifactRole": { "enum": ["primary", "base", "roof"] },
    "artifactOutputSize": { "$ref": "#/definitions/size" },
    "cellIndex": { "type": "integer", "minimum": 0, "maximum": 999 },
    "frameId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "direction": { "enum": ["front", "back", "left", "right"] },
    "semanticRole": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
    "targetRect": { "$ref": "#/definitions/rect" },
    "expectation": {
      "enum": ["expected-nonempty", "semantic-transparent", "reserved-transparent"]
    },
    "sourceRequired": { "type": "boolean" },
    "visualContent": { "type": "string", "minLength": 24 },
    "generationMode": { "enum": ["per-unit", "monolithic-atlas", "terrain-composed-atlas"] },
    "unitPromptText": { "type": "string", "minLength": 128 },
    "unitPromptSha256": { "$ref": "#/definitions/sha256" },
    "inputReferences": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": [
        { "$ref": "#/definitions/globalReference" },
        { "$ref": "#/definitions/subjectReference" }
      ],
      "additionalItems": false
    },
    "consistencyPlanId": { "type": "string", "pattern": "^identity_[a-f0-9]{20}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "expectation": { "const": "expected-nonempty" } }, "required": ["expectation"] },
      "then": { "properties": { "sourceRequired": { "const": true } } },
      "else": { "properties": { "sourceRequired": { "const": false } } }
    }
  ],
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "height": { "type": "integer", "minimum": 1, "maximum": 8192 }
      }
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer", "minimum": 0, "maximum": 8192 },
        "y": { "type": "integer", "minimum": 0, "maximum": 8192 },
        "width": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "height": { "type": "integer", "minimum": 1, "maximum": 8192 }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256", "role"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/definitions/sha256" },
        "role": { "enum": ["global-style", "primary-subject"] }
      }
    },
    "globalReference": {
      "allOf": [
        { "$ref": "#/definitions/reference" },
        { "type": "object", "properties": { "role": { "const": "global-style" } } }
      ]
    },
    "subjectReference": {
      "allOf": [
        { "$ref": "#/definitions/reference" },
        { "type": "object", "properties": { "role": { "const": "primary-subject" } } }
      ]
    }
  }
}
