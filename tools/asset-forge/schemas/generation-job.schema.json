{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codecity-inspector.local/asset-forge/generation-job.schema.json",
  "title": "GenerationJob",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "assetId", "provider", "dryRun", "subscriptionRun", "promptText",
    "promptHash", "promptFiles", "referenceImageIds", "outputDir", "createdBy"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "assetId": { "type": "string", "minLength": 1 },
    "provider": { "enum": ["mock", "job-pack", "manual-import", "codex-subscription"] },
    "dryRun": { "type": "boolean" },
    "subscriptionRun": { "type": "boolean" },
    "promptText": { "type": "string" },
    "promptHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "promptFiles": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "referenceImageIds": { "type": "array", "items": { "type": "string" } },
    "outputDir": { "type": "string", "pattern": "^generated/[a-z]+/pending$" },
    "createdBy": { "enum": ["codex", "human", "script"] }
  }
}
