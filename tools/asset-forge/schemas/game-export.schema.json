{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codecity-inspector.local/asset-forge/game-export.schema.json",
  "title": "GameAssetExport",
  "oneOf": [
    { "$ref": "#/definitions/manifestV1" },
    { "$ref": "#/definitions/manifestV2" }
  ],
  "definitions": {
    "missingBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vocabulary", "runtimeId"],
      "properties": {
        "vocabulary": { "type": "string", "minLength": 1 },
        "runtimeId": { "type": "string", "minLength": 1 }
      }
    },
    "assetV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "category", "sha256", "publicPath", "gameBinding"],
      "properties": {
        "assetId": { "type": "string", "minLength": 1 },
        "category": { "enum": ["character", "building", "field", "object", "ui", "effect"] },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "publicPath": { "type": "string", "pattern": "^/assets/forge/v1/[a-z0-9_./-]+\\.png$" },
        "gameBinding": { "$ref": "asset-definition.schema.json#/definitions/gameBinding" }
      }
    },
    "assetV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "category", "sha256", "publicPath", "gameBinding", "renderSpec"],
      "properties": {
        "assetId": { "type": "string", "minLength": 1 },
        "category": { "enum": ["character", "building", "field", "object", "ui", "effect"] },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "publicPath": { "type": "string", "pattern": "^/assets/forge/v1/[a-z0-9_./-]+\\.png$" },
        "gameBinding": { "$ref": "asset-definition.schema.json#/definitions/gameBinding" },
        "renderSpec": { "$ref": "#/definitions/renderSpec" }
      }
    },
    "manifestV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "generatedAt", "complete", "assets", "missingBindings"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "generatedAt": { "type": "string", "format": "date-time" },
        "complete": { "type": "boolean" },
        "assets": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/definitions/assetV1" }
        },
        "missingBindings": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/definitions/missingBinding" }
        }
      }
    },
    "manifestV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "generatedAt", "complete", "assets", "missingBindings", "missingAssets"],
      "properties": {
        "schemaVersion": { "const": 2 },
        "generatedAt": { "type": "string", "format": "date-time" },
        "complete": { "type": "boolean" },
        "assets": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/definitions/assetV2" }
        },
        "missingBindings": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/definitions/missingBinding" }
        },
        "missingAssets": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(character|building|field|object|ui|effect)\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*$"
          }
        }
      }
    },
    "positiveSize": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "spriteGrid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "rows", "frameWidth", "frameHeight"],
      "properties": {
        "columns": { "type": "integer", "minimum": 1 },
        "rows": { "type": "integer", "minimum": 1 },
        "frameWidth": { "type": "integer", "minimum": 1 },
        "frameHeight": { "type": "integer", "minimum": 1 }
      }
    },
    "sprites": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directions", "frames", "grid", "directionAxis", "frameAxis"],
      "properties": {
        "directions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["front", "back", "left", "right"] }
        },
        "frames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "grid": { "$ref": "#/definitions/spriteGrid" },
        "directionAxis": { "enum": ["column", "row", null] },
        "frameAxis": { "enum": ["column", "row"] }
      }
    },
    "renderSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "logicalSize", "tileSize", "nearestNeighbor", "allowAntiAlias",
        "sprites", "states", "variantTags"
      ],
      "properties": {
        "kind": { "enum": ["single", "spritesheet", "tileset", "ui-sheet"] },
        "logicalSize": {
          "anyOf": [
            { "$ref": "#/definitions/positiveSize" },
            { "type": "null" }
          ]
        },
        "tileSize": {
          "anyOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        },
        "nearestNeighbor": { "type": "boolean" },
        "allowAntiAlias": { "type": "boolean" },
        "sprites": {
          "anyOf": [
            { "$ref": "#/definitions/sprites" },
            { "type": "null" }
          ]
        },
        "states": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "variantTags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "spritesheet" } } },
          "then": {
            "properties": {
              "logicalSize": { "$ref": "#/definitions/positiveSize" },
              "sprites": { "$ref": "#/definitions/sprites" }
            }
          },
          "else": { "properties": { "sprites": { "type": "null" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "tileset" } } },
          "then": { "properties": { "tileSize": { "type": "integer", "minimum": 1 } } }
        }
      ]
    }
  }
}
