    "batch": "node src/cli.mjs batch",
    "make-job": "node src/cli.mjs make-job",
    "make-job-v2": "node src/cli.mjs make-job-v2",
    "import": "node src/cli.mjs import",
    "import-v2": "node src/cli.mjs import-v2",
    "validate": "node src/cli.mjs validate",
    "process": "node src/cli.mjs process",
    "approve-wave-a": "node src/cli.mjs approve-wave-a",
    "promote": "node src/cli.mjs promote",
    "promote-required": "node src/cli.mjs promote-required",
    "reject": "node src/cli.mjs reject",
    "export": "node src/cli.mjs export",
    "export-v3": "node src/cli.mjs export-v3",
    "list": "node src/cli.mjs list",
    "list-v2": "node src/cli.mjs list-v2",
