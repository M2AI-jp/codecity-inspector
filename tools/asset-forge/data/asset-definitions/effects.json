{
  "$schema": "../../schemas/asset-catalog.schema.json",
  "schemaVersion": 1,
  "category": "effect",
  "assets": [
    {
      "id": "effect.window_light",
      "category": "effect",
      "displayName": "Window Light",
      "gameMeaning": "Required effect art for effect.window_light.",
      "required": true,
      "promptFiles": [
        "prompts/common/pixel-art-style.md",
        "prompts/effects/00_common_effect_style.md",
        "prompts/common/reward-fraud-rules.md"
      ],
      "defaultReferenceIds": [
        "effect_style_master"
      ],
      "output": {
        "kind": "spritesheet",
        "preferredFormat": "png",
        "background": "transparent",
        "needsTransparency": true,
        "needsTrim": false
      },
      "pixelArt": {
        "logicalSpriteSize": {
          "width": 16,
          "height": 16
        },
        "scalePreview": 4,
        "nearestNeighbor": true,
        "allowAntiAlias": false
      },
      "sprites": {
        "frames": [
          "frame_1",
          "frame_2",
          "frame_3",
          "frame_4"
        ],
        "grid": {
          "columns": 4,
          "rows": 1,
          "frameWidth": 16,
          "frameHeight": 16
        }
      },
      "tags": [
        "effect",
        "window_light"
      ],
      "constraints": {
        "must": [
          "stable frame bounds",
          "readable short animation"
        ],
        "mustNot": [
          "soft blur",
          "labels",
          "baked scene background"
        ]
      },
      "reviewChecklist": [
        "フレーム間で位置がぶれないか",
        "効果の意味が読めるか",
        "背景が透過されているか"
      ],
      "gameBinding": {
        "rendererCategory": "effect",
        "semanticKind": "window_light",
        "drawLayer": "effect",
        "runtimeBindings": [],
        "coverage": "future"
      }
    },
