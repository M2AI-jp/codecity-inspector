      "defaultReferenceIds": [
        "intake_20260713_ui_dialogue_frames"
      ],
      "output": {
        "kind": "ui-sheet",
        "preferredFormat": "png",
        "background": "transparent",
        "needsTransparency": true,
        "needsTrim": false
      },
      "pixelArt": {
        "scalePreview": 3,
        "nearestNeighbor": true,
        "allowAntiAlias": false
      },
      "tags": [
        "ui",
        "dialogue_window"
      ],
      "constraints": {
        "must": [
          "crisp readable border",
          "empty content space where applicable"
        ],
        "mustNot": [
          "repository-specific text",
          "watermark",
          "soft blur"
        ]
      },
      "reviewChecklist": [
        "実寸で読めるか",
        "本文領域を邪魔しないか",
        "既存UIの役割と一致するか"
      ],
      "gameBinding": {
        "rendererCategory": "ui",
        "semanticKind": "dialogue_window",
        "drawLayer": "ui",
        "runtimeBindings": [],
        "coverage": "future"
