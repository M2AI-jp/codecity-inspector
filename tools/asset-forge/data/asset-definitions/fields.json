  "category": "field",
  "assets": [
    {
      "id": "field.cobblestone",
      "category": "field",
      "displayName": "Cobblestone",
      "gameMeaning": "Required field art for field.cobblestone.",
      "required": true,
      "promptFiles": [
        "prompts/common/pixel-art-style.md",
        "prompts/fields/00_common_field_style.md",
        "prompts/common/reward-fraud-rules.md"
      ],
      "defaultReferenceIds": [
        "world_visual_master",
        "intake_20260713_field_cobblestone_roads"
      ],
      "output": {
        "kind": "tileset",
        "preferredFormat": "png",
        "background": "transparent",
        "needsTransparency": true,
        "needsTrim": false
      },
      "pixelArt": {
        "tileSize": 64,
        "scalePreview": 4,
        "nearestNeighbor": true,
        "allowAntiAlias": false
      },
      "tags": [
        "field",
        "cobblestone"
      ],
      "constraints": {
        "must": [
          "single mossy irregular rock cluster with a readable natural silhouette",
          "transparent corners and transparent space around the subject",
          "hard pixel-art alpha edge with the subject contained inside the 64x64 canvas",
          "terrain feature overlay that remains readable when composited over field.grass"
        ],
        "mustNot": [
          "opaque square or green ground tile",
          "matte, halo, scene background, or drop shadow",
          "round pebble or regular geometric rock",
          "characters",
          "labels",
          "soft antialiasing"
        ]
      },
      "reviewChecklist": [
        "四隅が完全に透明で不透明な四角がないか",
        "草地へ重ねても緑のマットや縁取りが見えないか",
        "苔むした不規則な岩塊として読めるか",
        "64x64の中で小さすぎず、周囲の透明余白を保っているか"
      ],
      "gameBinding": {
        "rendererCategory": "tile",
        "semanticKind": "cobblestone",
        "drawLayer": "object",
        "runtimeBindings": [
          {
            "vocabulary": "TILE_TYPES",
            "id": "road"
          }
        ],
        "coverage": "mapped"
      }
    },
