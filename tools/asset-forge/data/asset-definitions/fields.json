  "assets": [
    {
      "id": "field.cobblestone",
      "category": "field",
      "displayName": "Cobblestone",
      "gameMeaning": "Required field art for field.cobblestone.",
      "required": true,
      "promptFiles": [
        "prompts/common/pixel-art-style.md",
        "prompts/fields/00_common_field_style.md",
        "prompts/common/reward-fraud-rules.md"
      ],
      "defaultReferenceIds": [
        "field_style_master"
      ],
      "output": {
        "kind": "tileset",
        "preferredFormat": "png",
        "background": "scene",
        "needsTransparency": false,
        "needsTrim": false
      },
      "pixelArt": {
        "tileSize": 16,
        "scalePreview": 4,
        "nearestNeighbor": true,
        "allowAntiAlias": false
      },
      "tags": [
        "field",
        "cobblestone"
      ],
      "constraints": {
        "must": [
          "tile-aligned edges",
          "repeatable texture",
          "walkability meaning remains visible"
        ],
        "mustNot": [
          "characters",
          "labels",
          "soft antialiasing"
        ]
      },
      "reviewChecklist": [
        "継ぎ目が目立たないか",
        "接続方向が読めるか",
        "地形の意味が変わっていないか"
      ],
      "gameBinding": {
        "rendererCategory": "tile",
        "semanticKind": "cobblestone",
        "drawLayer": "ground",
        "runtimeBindings": [
          {
            "vocabulary": "TILE_TYPES",
            "id": "road"
          }
        ],
        "coverage": "mapped"
      }
    },
