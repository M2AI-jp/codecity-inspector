        "nearestNeighbor": true,
        "allowAntiAlias": false
      },
      "tags": [
        "field",
        "dirt_path"
      ],
      "constraints": {
        "must": [
        "64x64 opaque repeatable compacted-earth ground tile",
        "readable larger soil patches, embedded stones, shallow footprints, moss, and leaf litter",
        "deliberate low-frequency pixel clusters rather than random grain",
        "non-directional walkable woodland path"
        ],
        "mustNot": [
        "transparent pixels or object-overlay treatment",
        "uniform brown grain, TV noise, or high-frequency static",
        "directional border, square frame, or isolated central object",
          "characters",
          "labels",
          "soft antialiasing"
        ]
      },
      "reviewChecklist": [
      "64x64実寸で踏み固めた土・大小の石・苔・落葉が読めるか",
      "茶色い粒状ノイズや単色の静電ノイズに見えないか",
      "四辺を反復しても継ぎ目や四角い枠が目立たないか",
      "キャラクターや建物の輪郭を邪魔しないか"
