    {
      "id": "object.barrel",
      "category": "object",
      "displayName": "Barrel",
      "gameMeaning": "Required object art for object.barrel.",
      "required": true,
      "promptFiles": [
        "prompts/common/pixel-art-style.md",
        "prompts/objects/00_common_object_style.md",
        "prompts/common/reward-fraud-rules.md"
      ],
      "defaultReferenceIds": [
        "world_visual_master",
        "intake_20260713_object_street_props"
      ],
      "output": {
        "kind": "single",
        "preferredFormat": "png",
        "background": "transparent",
        "needsTransparency": true,
        "needsTrim": true
      },
      "pixelArt": {
        "logicalSpriteSize": {
          "width": 64,
          "height": 64
        },
        "scalePreview": 4,
        "nearestNeighbor": true,
        "allowAntiAlias": false
      },
      "tags": [
        "object",
        "barrel"
      ],
      "constraints": {
        "must": [
          "clear map-scale silhouette",
          "consistent tile footprint"
        ],
        "mustNot": [
          "scene background",
          "labels",
          "oversized detail"
        ]
      },
      "reviewChecklist": [
        "小サイズで識別できるか",
        "他の小物と縮尺が合うか",
        "背景が混入していないか"
      ],
      "gameBinding": {
        "rendererCategory": "prop",
        "semanticKind": "barrel",
        "drawLayer": "object",
        "runtimeBindings": [
          {
            "vocabulary": "PROP_KINDS",
            "id": "barrel"
          }
        ],
        "coverage": "exact"
      }
    },
