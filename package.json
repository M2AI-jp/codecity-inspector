{
  "name": "codecity",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "A repository becomes a playable pixel-art RPG town.",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "codecity": "ship/90-cli/bin/codecity.mjs"
  },
  "exports": {
    ".": "./ship/90-cli/index.mjs"
  },
  "files": [
    "ship/10-inspect/index.mjs",
    "ship/20-semantics/index.mjs",
    "ship/20-semantics/configuration/",
    "ship/20-semantics/data/",
    "ship/20-semantics/interface/",
    "ship/20-semantics/service/",
    "ship/30-town-domain/index.mjs",
    "ship/40-worldgen/index.mjs",
    "ship/50-art/index.mjs",
    "ship/50-art/manifest.json",
    "ship/50-art/scene-bindings.json",
    "ship/50-art/assets/",
    "ship/60-scene-compiler/index.mjs",
    "ship/70-game-runtime/app.mjs",
    "ship/70-game-runtime/index.html",
    "ship/70-game-runtime/index.mjs",
    "ship/70-game-runtime/state.mjs",
    "ship/70-game-runtime/styles.css",
    "ship/80-local-server/index.mjs",
    "ship/90-cli/bin/codecity.mjs",
    "ship/90-cli/index.mjs",
    "README.md"
  ],
  "scripts": {
    "check:boundaries": "node studio/quality/contracts/check-boundaries.mjs",
    "check:pixel-art": "node studio/quality/gates/check-pixel-art.mjs",
    "test": "node --test",
    "check": "npm run check:boundaries && npm test"
  }
}
